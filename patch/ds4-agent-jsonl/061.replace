/*DS4UI_JSONL*/
static char *ds4ui_execute_cowork_tool(const agent_tool_call *call) {
    static const char *const arg_names[] = {
        "action", "path", "sheet", "range", "data_json", "sheets_json",
        "header", "title", "content", "slides_json"
    };
    ds4_cowork_arg args[sizeof(arg_names) / sizeof(arg_names[0])];
    size_t nargs = 0;
    for (size_t i = 0; i < sizeof(arg_names) / sizeof(arg_names[0]); i++) {
        const char *value = agent_tool_arg_value(call, arg_names[i]);
        if (!value) continue;
        args[nargs].name = arg_names[i];
        args[nargs].value = value;
        nargs++;
    }
    char cwd[PATH_MAX];
    const char *workspace = getcwd(cwd, sizeof(cwd)) ? cwd : ".";
    char *result = ds4_cowork_execute(call->name, args, nargs, workspace);
    if (!result) return xstrdup("Cowork tool error: out of memory\n");
    char *copy = xstrdup(result);
    ds4_cowork_free(result);
    return copy;
}

static char *agent_execute_tool_call(agent_worker *w, const agent_tool_call *call) {
    agent_buf result = {0};
    if (!call->name) return xstrdup("Tool error: missing tool name\n");
    const char *runtime = getenv("DS4UI_RUNTIME_NAME");
    if (runtime && !strcmp(runtime, "cowork") && ds4_cowork_tool_known(call->name))
        return ds4ui_execute_cowork_tool(call);   /*DS4UI_JSONL*/
