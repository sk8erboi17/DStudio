+    const char *seg = path;
+    for (const char *p = path; ; p++) {
+        if (*p == '/' || *p == '\\' || *p == '\0') {
+            size_t n = (size_t)(p - seg);
+            if (n == 2 && seg[0] == '.' && seg[1] == '.') return 0;
+            if (!*p) break;
+            seg = p + 1;
+        }
+    }
+    return 1;
