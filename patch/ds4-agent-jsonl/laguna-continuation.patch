+/* Reject an oversized request before compacting or appending datetime context.
+ * Tokenization is private; admission must not replace an existing conversation. */
+static bool agent_worker_prepare_user(agent_worker *w, const char *text,
+                                      ds4_tokens *message, int *headroom,
+                                      char *err, size_t err_len) {
+    ds4_tokens sys = {0}, prefix = {0};
+    ds4_chat_append_message(w->engine, message, "user", text ? text : "");
+    ds4_chat_append_assistant_prefix(w->engine, &prefix, effective_think_mode(w->cfg));
+    *headroom = prefix.len + 1;
+    ds4_tokens_free(&prefix);
+    agent_worker_build_system_base_tokens(w, &sys);
+    int ctx = agent_worker_effective_ctx_size(w);
+    bool ok = message->len <= ctx - sys.len - *headroom;
+    ds4_tokens_free(&sys);
+    if (!ok)
+        snprintf(err, err_len, "user message is too large for --ctx %d; use a larger context or a smaller message", ctx);
+    return ok;
+}
+
+static bool agent_worker_append_prepared_user(agent_worker *w, const ds4_tokens *message,
+                                              int headroom, char *err, size_t err_len) {
+    int ctx = agent_worker_effective_ctx_size(w);
+    bool ok = true;
+    if (message->len > ctx - w->transcript.len - headroom) {
+        ok = agent_worker_compact(w, "make room for incoming user message", err, err_len);
+        if (ok && message->len > ctx - w->transcript.len - headroom) {
+            snprintf(err, err_len, "user message does not fit after compaction; use a larger --ctx");
+            ok = false;
+        }
+    }
+    if (ok) agent_tokens_append_range(&w->transcript, message, 0, message->len);
+    return ok;
 }
 
+static bool agent_worker_append_user(agent_worker *w, const char *text,
+                                     char *err, size_t err_len) {
+    ds4_tokens message = {0};
+    int headroom = 0;
+    bool ok = agent_worker_prepare_user(w, text, &message, &headroom, err, err_len) &&
+              agent_worker_append_prepared_user(w, &message, headroom, err, err_len);
+    ds4_tokens_free(&message);
+    return ok;
+}
