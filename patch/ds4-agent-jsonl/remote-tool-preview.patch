+/* Structured calls (llama.cpp/MLX): the transport turns argument fragments
+ * into the live stanza lines the DSML stream emits (tool_call_begin,
+ * tool_call_param, tool_body_delta), published in order with the text. A
+ * preview only: execution still waits for the validated batch. */
+static void ds4ui_remote_preview(void *owner, const char *line, size_t len) {
+    ds4ui_remote_stream_ctx *ctx = owner;
+    if (!ctx || !ctx->worker || !line || !len) return;
+    if (ctx->reasoning_open) { ds4ui_emit_event(ctx->worker, "reasoning_end"); ctx->reasoning_open = false; }
+    agent_publish(ctx->worker, line, len);
+    ds4ui_remote_flush(ctx->worker);
+}
