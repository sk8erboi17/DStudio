+static bool agent_qwen_value_is_json(const char *v, size_t n) {
+    while (n && (v[0] == ' ' || v[0] == '\t')) { v++; n--; }
+    while (n && (v[n - 1] == ' ' || v[n - 1] == '\t' || v[n - 1] == '\n')) n--;
+    if (!n) return false;
+    if ((v[0] == '{' && v[n - 1] == '}') || (v[0] == '[' && v[n - 1] == ']')) return true;
