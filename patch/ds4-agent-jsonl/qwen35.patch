+/*DS4UI_JSONL*/
+/* Opt-in structured output for the UI: one JSON line per event, prefixed by
+ * \x1e (Record Separator) so the consumer tells events from text without
+ * heuristics. Additive: active only with --jsonl. */
+static void ds4ui_json_escape(const char *s, char *out, size_t cap) {
+    size_t o = 0;
+    for (; s && *s && o + 7 < cap; s++) {
+        unsigned char c = (unsigned char)*s;
+        if (c == '"' || c == '\\') { out[o++] = '\\'; out[o++] = (char)c; }
+        else if (c == '\n') { out[o++] = '\\'; out[o++] = 'n'; }
+        else if (c == '\r') { out[o++] = '\\'; out[o++] = 'r'; }
+        else if (c == '\t') { out[o++] = '\\'; out[o++] = 't'; }
+        else if (c < 0x20) { o += (size_t)snprintf(out + o, cap - o, "\\u%04x", c); }
+        else out[o++] = (char)c;
+    }
+    out[o] = '\0';
+}
+static void ds4ui_emit_event(agent_worker *w, const char *type) {
+    char line[128];
+    int k = snprintf(line, sizeof line, "\x1e{\"type\":\"%s\"}\n", type);
+    agent_publish(w, line, (size_t)k);
+}
+static void ds4ui_emit_question(agent_worker *w, const char *id, const char *title, const char *questions_json) {
+    char iid[256], ttl[512];
+    ds4ui_json_escape(id ? id : "question", iid, sizeof iid);
+    ds4ui_json_escape(title ? title : "Question", ttl, sizeof ttl);
+    const char *q = (questions_json && questions_json[0]) ? questions_json : "[]";
+    size_t ql = strlen(q), cap = ql + 1024;
+    char *line = (char *)malloc(cap);
+    if (!line) return;
+    int k = snprintf(line, cap, "\x1e{\"type\":\"question\",\"id\":\"%s\",\"title\":\"%s\",\"questions\":", iid, ttl);
+    for (; *q && k + 2 < (int)cap; q++) {
+        char c = *q;
+        if (c == '\n' || c == '\r' || c == '\x1e') c = ' ';
+        line[k++] = c;
+    }
+    k += snprintf(line + k, cap - (size_t)k, "}\n");
+    agent_publish(w, line, (size_t)k);
+    free(line);
+}
+/* GSA/RSA phase payloads are control-plane data, never assistant prose. Keep
