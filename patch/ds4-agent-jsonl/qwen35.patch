+    if (n >= sizeof(tmp)) return false;
+    memcpy(tmp, v, n);
+    tmp[n] = '\0';
+    char *endp = NULL;
+    (void)strtod(tmp, &endp);
+    return endp && *endp == '\0' && endp != tmp;
