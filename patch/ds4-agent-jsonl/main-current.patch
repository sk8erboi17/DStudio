+/* read_pdf: reads a PDF text layer via DStudio's /api/pdf/describe endpoint.
+ * Scanned/image-only pages are reported and skipped; vision belongs to the
+ * selected model's native image tools, not to a document sidecar. The
+ * by-content-hash result cache lives server-side. An
+ * optional pages range ("N" | "N-M" | "N-") is passed through verbatim — how
+ * the model continues past the server's caps on a long document. */
+static void ds4ui_json_escape_into(agent_buf *b, const char *s) {
+    for (; s && *s; s++) {
