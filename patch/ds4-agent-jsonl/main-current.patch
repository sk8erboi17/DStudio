+static const char *ds4ui_json_ws(const char *p, const char *end) { while (p < end && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')) p++; return p; }
+static int ds4ui_json_hex(char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }
+static const char *ds4ui_json_skip_value(const char *p, const char *end, int depth, char *err, size_t errsz);
+static const char *ds4ui_json_skip_string(const char *p, const char *end, char *err, size_t errsz) {
+    if (p >= end || *p != '\"') { snprintf(err, errsz, "expected JSON string"); return NULL; }
+    for (p++; p < end;) {
+        unsigned char c = (unsigned char)*p++;
+        if (c == '\"') return p;
+        if (c < 0x20) { snprintf(err, errsz, "control character in JSON string"); return NULL; }
+        if (c != '\\') continue;
+        if (p >= end) { snprintf(err, errsz, "unterminated JSON escape"); return NULL; }
+        char e = *p++;
+        if (e == '\"' || e == '\\' || e == '/' || e == 'b' || e == 'f' || e == 'n' || e == 'r' || e == 't') continue;
+        if (e == 'u') {
+            if (end - p < 4 || !ds4ui_json_hex(p[0]) || !ds4ui_json_hex(p[1]) || !ds4ui_json_hex(p[2]) || !ds4ui_json_hex(p[3])) { snprintf(err, errsz, "bad JSON unicode escape"); return NULL; }
+            p += 4; continue;
+        }
+        snprintf(err, errsz, "bad JSON escape"); return NULL;
+    }
+    snprintf(err, errsz, "unterminated JSON string"); return NULL;
+}
+static const char *ds4ui_json_skip_number(const char *p, const char *end, char *err, size_t errsz) {
+    if (p < end && *p == '-') p++;
+    if (p >= end) { snprintf(err, errsz, "bad JSON number"); return NULL; }
+    if (*p == '0') p++;
+    else if (*p >= '1' && *p <= '9') { while (p < end && isdigit((unsigned char)*p)) p++; }
+    else { snprintf(err, errsz, "bad JSON number"); return NULL; }
+    if (p < end && *p == '.') { p++; if (p >= end || !isdigit((unsigned char)*p)) { snprintf(err, errsz, "bad JSON number"); return NULL; } while (p < end && isdigit((unsigned char)*p)) p++; }
+    if (p < end && (*p == 'e' || *p == 'E')) { p++; if (p < end && (*p == '+' || *p == '-')) p++; if (p >= end || !isdigit((unsigned char)*p)) { snprintf(err, errsz, "bad JSON number"); return NULL; } while (p < end && isdigit((unsigned char)*p)) p++; }
+    return p;
+}
+static const char *ds4ui_json_skip_array(const char *p, const char *end, int depth, char *err, size_t errsz) {
+    p++; p = ds4ui_json_ws(p, end);
+    if (p < end && *p == ']') return p + 1;
+    for (;;) { p = ds4ui_json_skip_value(p, end, depth + 1, err, errsz); if (!p) return NULL; p = ds4ui_json_ws(p, end); if (p < end && *p == ',') { p++; continue; } if (p < end && *p == ']') return p + 1; snprintf(err, errsz, "expected ',' or ']' in JSON array"); return NULL; }
+}
+static const char *ds4ui_json_skip_object(const char *p, const char *end, int depth, char *err, size_t errsz) {
+    p++; p = ds4ui_json_ws(p, end);
+    if (p < end && *p == '}') return p + 1;
+    for (;;) { p = ds4ui_json_ws(p, end); if (p >= end || *p != '\"') { snprintf(err, errsz, "expected JSON object key"); return NULL; } p = ds4ui_json_skip_string(p, end, err, errsz); if (!p) return NULL; p = ds4ui_json_ws(p, end); if (p >= end || *p != ':') { snprintf(err, errsz, "expected ':' after JSON object key"); return NULL; } p++; p = ds4ui_json_skip_value(p, end, depth + 1, err, errsz); if (!p) return NULL; p = ds4ui_json_ws(p, end); if (p < end && *p == ',') { p++; continue; } if (p < end && *p == '}') return p + 1; snprintf(err, errsz, "expected ',' or '}' in JSON object"); return NULL; }
+}
+static const char *ds4ui_json_skip_value(const char *p, const char *end, int depth, char *err, size_t errsz) {
+    if (depth > 64) { snprintf(err, errsz, "JSON nesting too deep"); return NULL; }
+    p = ds4ui_json_ws(p, end);
+    if (p >= end) { snprintf(err, errsz, "expected JSON value"); return NULL; }
+    if (*p == '\"') return ds4ui_json_skip_string(p, end, err, errsz);
+    if (*p == '{') return ds4ui_json_skip_object(p, end, depth, err, errsz);
+    if (*p == '[') return ds4ui_json_skip_array(p, end, depth, err, errsz);
+    if (*p == '-' || isdigit((unsigned char)*p)) return ds4ui_json_skip_number(p, end, err, errsz);
+    if (end - p >= 4 && !memcmp(p, "true", 4)) return p + 4;
+    if (end - p >= 5 && !memcmp(p, "false", 5)) return p + 5;
+    if (end - p >= 4 && !memcmp(p, "null", 4)) return p + 4;
+    snprintf(err, errsz, "bad JSON value"); return NULL;
+}
+static int ds4ui_json_validate_array(const char *json, char *err, size_t errsz) {
+    if (!json) { snprintf(err, errsz, "missing JSON"); return 0; }
+    const char *end = json + strlen(json);
+    const char *p = ds4ui_json_ws(json, end);
+    if (p >= end || *p != '[') { snprintf(err, errsz, "JSON must start with '['"); return 0; }
+    p = ds4ui_json_skip_value(p, end, 0, err, errsz);
+    if (!p) return 0;
+    p = ds4ui_json_ws(p, end);
+    if (p != end) { snprintf(err, errsz, "trailing data after JSON value"); return 0; }
+    return 1;
+}
+static int ds4ui_json_validate_object(const char *json, char *err, size_t errsz) {
+    if (!json) { snprintf(err, errsz, "missing JSON"); return 0; }
+    const char *end = json + strlen(json);
+    const char *p = ds4ui_json_ws(json, end);
+    if (p >= end || *p != '{') { snprintf(err, errsz, "JSON must start with '{'"); return 0; }
+    p = ds4ui_json_skip_value(p, end, 0, err, errsz);
+    if (!p) return 0;
+    p = ds4ui_json_ws(p, end);
+    if (p != end) { snprintf(err, errsz, "trailing data after JSON object"); return 0; }
+    return 1;
+}
