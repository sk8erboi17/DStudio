+    size_t prefix = !strcmp(workspace, "/") ? 0 : strlen(workspace);
+    if (strncmp(workspace, resolved, prefix) || resolved[prefix] != '/' || !resolved[prefix + 1]) goto early;
+    snprintf(relative, sizeof relative, "%s", resolved + prefix + 1);
+    int directory = open(".", O_RDONLY | O_DIRECTORY | O_CLOEXEC), fd = -1;
+    unsigned char *bytes = NULL; char *url = NULL, *part = relative;
+    if (directory < 0) goto early;
+    for (;;) {
+        char *slash = strchr(part, '/');
+        if (!slash) break;
+        *slash = '\0';
+        int next = openat(directory, part, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        if (next < 0) goto done;
+        close(directory); directory = next; part = slash + 1;
+    }
+    fd = openat(directory, part, O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC);
+    struct stat before, after, named;
+    if (fd < 0 || fstat(fd, &before) || !S_ISREG(before.st_mode)) goto done;
+    failure = "Tool error: image must be a nonempty PNG/JPEG of at most 2 MiB; no bytes attached.";
+    if (before.st_size <= 0 || before.st_size > DS4UI_REMOTE_IMAGE_BYTES) goto done;
