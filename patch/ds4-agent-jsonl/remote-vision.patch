+/* File-read success is not model admission. A complete model response confirms
+ * only the pending observations in that request. Error/Stop retires those
+ * candidates, not earlier accepted images or original tool receipts/files.
+ * No read is automatically replayed; a new tool call is needed to try again. */
+static void ds4ui_remote_images_reply(ds4ui_msg_list *m, bool accepted) {
+    for (int i = 0; i < m->n; i++) {
+        ds4ui_remote_tool_group *g = m->v[i].group;
+        for (int j = 0; g && j < g->count; j++) {
+            ds4ui_remote_call *c = &g->calls[j];
+            if (c->image_delivery != DS4UI_IMAGE_PENDING) continue;
+            c->image_delivery = accepted ? DS4UI_IMAGE_ACCEPTED : DS4UI_IMAGE_REJECTED;
+            if (!accepted && c->image_url) {
+                size_t n = strlen(c->image_url); g->bytes -= n; m->content_bytes -= n;
+                free(c->image_url); c->image_url = NULL;
+            }
+        }
+    }
+}
