+    bool indexed;
+} ds4_gpu_stream_expert_active_iter;
+
+static inline void ds4_gpu_stream_expert_active_set(
+        uint32_t layer,
+        uint32_t expert) {
+    const uint32_t key =
+        layer * DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT + expert;
+    g_stream_expert_cache_active_bits[key >> 6] |= 1ull << (key & 63u);
+}
+
+static inline void ds4_gpu_stream_expert_active_clear(
+        uint32_t layer,
+        uint32_t expert) {
+    const uint32_t key =
+        layer * DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT + expert;
+    g_stream_expert_cache_active_bits[key >> 6] &= ~(1ull << (key & 63u));
+}
+
+static inline void ds4_gpu_stream_expert_active_iter_init(
+        ds4_gpu_stream_expert_active_iter *it) {
+    it->word = 0;
+    it->key = 0;
+    it->indexed = g_stream_expert_cache_active_index_enabled != 0;
+    it->pending = it->indexed ? g_stream_expert_cache_active_bits[0] : 0;
+}
+
+/* Iterating set bits in numeric order preserves the old layer-major/expert-
+ * major victim order while skipping empty cache matrix cells. */
+static inline int ds4_gpu_stream_expert_active_iter_next(
+        ds4_gpu_stream_expert_active_iter *it,
+        uint32_t *layer,
+        uint32_t *expert) {
+    if (!it->indexed) {
+        if (it->key >= DS4_METAL_STREAM_EXPERT_CACHE_MAX_ENTRIES) return 0;
+        *layer = it->key / DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT;
+        *expert = it->key % DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT;
+        it->key++;
+        return 1;
+    }
+    while (it->pending == 0) {
+        if (++it->word >= DS4_METAL_STREAM_EXPERT_ACTIVE_WORDS) return 0;
+        it->pending = g_stream_expert_cache_active_bits[it->word];
+    }
+    const uint32_t bit = (uint32_t)__builtin_ctzll(it->pending);
+    it->pending &= it->pending - 1u;
+    const uint32_t key = it->word * 64u + bit;
+    if (key >= DS4_METAL_STREAM_EXPERT_CACHE_MAX_ENTRIES) return 0;
+    *layer = key / DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT;
+    *expert = key % DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT;
+    return 1;
+}
+
+static int ds4_gpu_stream_expert_active_index_valid(void) {
+    uint32_t indexed = 0;
+    for (uint32_t layer = 0;
+         layer < DS4_METAL_STREAM_EXPERT_CACHE_MAX_LAYER;
+         layer++) {
+        for (uint32_t expert = 0;
+             expert < DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT;
+             expert++) {
+            const uint32_t key =
+                layer * DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT + expert;
+            const bool active =
+                (g_stream_expert_cache_active_bits[key >> 6] &
+                 (1ull << (key & 63u))) != 0;
+            if (active != (g_stream_expert_cache[layer][expert].valid != 0)) {
+                fprintf(stderr,
+                        "ds4: streaming expert active-index mismatch layer=%u expert=%u active=%d valid=%d\n",
+                        layer,
+                        expert,
+                        active ? 1 : 0,
+                        g_stream_expert_cache[layer][expert].valid ? 1 : 0);
+                return 0;
+            }
+            indexed += active ? 1u : 0u;
+        }
+    }
+    if (indexed != g_stream_expert_cache_entry_count) {
+        fprintf(stderr,
+                "ds4: streaming expert active-index count mismatch indexed=%u entries=%u\n",
+                indexed,
+                g_stream_expert_cache_entry_count);
+        return 0;
+    }
+    return 1;
+}
