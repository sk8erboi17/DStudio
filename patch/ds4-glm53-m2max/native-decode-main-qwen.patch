@@ -0,0 +1,220 @@
+/* Model-free oracle for the ported cache index and Q2 address consumer.
+ * Include the implementation to exercise private lifetime helpers without
+ * adding test-only entry points to the production backend API. */
+#include "../ds4_metal.m"
+
+bool ds4_log_is_tty(FILE *fp) { (void)fp; return false; }
+
+#define CHECK(x) do { if (!(x)) { \
+    fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); exit(1); \
+} } while (0)
+
+static void check_device_predicate(void) {
+    char saved[sizeof(g_metal_device_name)];
+    memcpy(saved, g_metal_device_name, sizeof(saved));
+    const char *names[] = {"Apple M2 Max", "Apple M2 Pro", "Apple M2 Ultra",
+        "Apple M3 Max", "Apple M4 Max", "Apple M5 Max", "Apple M2 Max Extra", ""};
+    for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+        snprintf(g_metal_device_name, sizeof(g_metal_device_name), "%s", names[i]);
+        CHECK(ds4_gpu_device_is_m2_max() == (i == 0));
+    }
+    memcpy(g_metal_device_name, saved, sizeof(saved));
+}
+
+static void check_iteration(void) {
+    ds4_gpu_stream_expert_active_iter it;
+    uint32_t layer, expert, count = 0, previous = 0;
+    g_stream_expert_cache_active_index_enabled = 1;
+    ds4_gpu_stream_expert_active_iter_init(&it);
+    while (ds4_gpu_stream_expert_active_iter_next(&it, &layer, &expert)) {
+        uint32_t key = layer * DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT + expert;
+        CHECK(g_stream_expert_cache[layer][expert].valid);
+        CHECK(count == 0 || key > previous);
+        previous = key;
+        count++;
+    }
+    CHECK(count == g_stream_expert_cache_entry_count);
+    CHECK(ds4_gpu_stream_expert_active_index_valid());
+    /* The fallback still visits the configured matrix, including empty cells. */
+    g_stream_expert_cache_active_index_enabled = 0;
+    ds4_gpu_stream_expert_active_iter_init(&it);
+    uint32_t full_visits = 0, full_active = 0;
+    while (ds4_gpu_stream_expert_active_iter_next(&it, &layer, &expert)) {
+        full_visits++;
+        full_active += g_stream_expert_cache[layer][expert].valid != 0;
+    }
+    CHECK(full_visits == DS4_METAL_STREAM_EXPERT_CACHE_MAX_ENTRIES);
+    CHECK(full_active == count);
+    g_stream_expert_cache_active_index_enabled = 1;
+}
+
+static void install_small(uint32_t key) {
+    uint32_t layer = key / DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT;
+    uint32_t expert = key % DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT;
+    id<MTLBuffer> b = [g_device newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    CHECK(b);
+    *(uint32_t *)b.contents = key;
+    /* No file mapping: clearing these entries must never advise user pages. */
+    CHECK(ds4_gpu_stream_expert_cache_install_loaded(
+        NULL, 0, layer, expert, 0, 64, 128, 64, 64, b, b, b, 0, 64, 128));
+}
+
+static void cache_sequence(int indexed, uint32_t victims[16]) {
+    ds4_gpu_set_streaming_expert_cache_budget(32);
+    for (uint32_t i = 0; i < 64; i++) {
+        install_small(i);
+        /* Deliberate exact ties exercise the old matrix traversal order. */
+        g_stream_expert_cache_route_hotness[0][i] = i % 4;
+        g_stream_expert_cache[0][i].last_used = i % 3;
+    }
+    const int32_t protected_ids[8] = {7, 6, 5, 4, 3, 2, 1, 0};
+    g_stream_expert_cache[0][8].inflight_seq = g_stream_expert_cache_done_seq + 1;
+    check_iteration();
+    g_stream_expert_cache_active_index_enabled = indexed;
+    ds4_gpu_stream_expert_reusable_buffers reuse[8] = {0};
+    CHECK(ds4_gpu_stream_expert_cache_take_reusable_batch(
+        8, 0, protected_ids, 8, 64, 64, reuse) == 8);
+    for (uint32_t i = 0; i < 8; i++) {
+        victims[i] = *(uint32_t *)reuse[i].gate_buffer.contents;
+        CHECK(victims[i] > 8);
+    }
+    for (uint32_t i = 8; i < 16; i++) {
+        CHECK(ds4_gpu_stream_expert_cache_take_reusable(
+            1, 0, protected_ids, 8, 64, 64, &reuse[0]));
+        victims[i] = *(uint32_t *)reuse[0].gate_buffer.contents;
+        CHECK(victims[i] > 8);
+    }
+    CHECK(g_stream_expert_cache_entry_count == 48);
+    CHECK(g_stream_expert_cache[0][8].valid);
+    ds4_gpu_stream_expert_cache_clear_entry(0, 8, 1);
+    CHECK(g_stream_expert_cache[0][8].valid); /* Still in flight. */
+    g_stream_expert_cache[0][8].inflight_seq = 0;
+    check_iteration();
+    ds4_gpu_stream_expert_cache_clear_all(1);
+    check_iteration();
+}
+
+static void check_cache(void) {
+    ds4_gpu_set_ssd_streaming(true); /* Synthetic buffers only; no GGUF or I/O. */
+    CHECK(setenv("DS4_METAL_ENABLE_STREAMING_EXPERT_ADDR_TABLE", "1", 1) == 0);
+    uint32_t matrix[16], indexed[16];
+    cache_sequence(0, matrix);
+    cache_sequence(1, indexed);
+    CHECK(memcmp(matrix, indexed, sizeof(matrix)) == 0);
+    /* Real install/replace/clear, including every 64-bit and layer boundary. */
+    const uint32_t keys[] = {0, 63, 64, 127, 128, 287, 383, 384, 30719};
+    for (uint32_t round = 0; round < 64; round++) {
+        for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+            install_small(keys[i]);
+            check_iteration();
+        }
+        for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+            install_small(keys[i]);
+            check_iteration();
+            ds4_gpu_stream_expert_cache_clear_entry(keys[i] / 384, keys[i] % 384, 1);
+            CHECK(((uint64_t *)g_stream_expert_cache_down_addr_buffers[keys[i] / 384].contents)[keys[i] % 384] == 0);
+            check_iteration();
+        }
+        CHECK(g_stream_expert_cache_bytes == 0);
+    }
+    printf("cache: ordered batch/single victims identical; 1152 installs/replaces; index %zu bytes\n",
+           sizeof(g_stream_expert_cache_active_bits));
+    ds4_gpu_stream_expert_cache_clear_all(1);
+    ds4_gpu_set_ssd_streaming(false);
+    CHECK(unsetenv("DS4_METAL_ENABLE_STREAMING_EXPERT_ADDR_TABLE") == 0);
+}
+
+typedef struct { uint8_t scales[16], qs[64]; uint16_t d, dmin; } test_q2_block;
+_Static_assert(sizeof(test_q2_block) == 84, "Q2_K layout");
+
+static void check_q2_address(void) {
+    enum { INPUT = 2048, OUTPUT = 4096, ROW_BYTES = INPUT / 256 * 84 };
+    const int32_t selected[8] = {287, 0, 191, 63, 127, 1, 64, 255};
+    const unsigned counts[] = {1, 2, 6, 7, 8};
+    id<MTLBuffer> weights[8];
+    id<MTLBuffer> addresses = [g_device newBufferWithLength:384 * 8 options:MTLResourceStorageModeShared];
+    id<MTLBuffer> ids = [g_device newBufferWithBytes:selected length:sizeof(selected) options:MTLResourceStorageModeShared];
+    id<MTLBuffer> input = [g_device newBufferWithLength:8 * INPUT * 4 options:MTLResourceStorageModeShared];
+    id<MTLBuffer> output = [g_device newBufferWithLength:OUTPUT * 4 options:MTLResourceStorageModeShared];
+    CHECK(addresses && ids && input && output);
+    memset(addresses.contents, 0, addresses.length);
+    ds4_gpu_stream_expert_cache_entry entries[8] = {0};
+    ds4_gpu_stream_expert_cache_entry *ptrs[8];
+    for (unsigned slot = 0; slot < 8; slot++) {
+        weights[slot] = [g_device newBufferWithLength:OUTPUT * ROW_BYTES options:MTLResourceStorageModeShared];
+        CHECK(weights[slot]);
+        test_q2_block *blocks = weights[slot].contents;
+        for (unsigned row = 0; row < OUTPUT; row++) {
+            for (unsigned b = 0; b < INPUT / 256; b++) {
+                test_q2_block *block = &blocks[row * (INPUT / 256) + b];
+                memset(block->scales, 1 + row % 4, sizeof(block->scales));
+                memset(block->qs, (1 + slot % 3) * 0x55, sizeof(block->qs));
+                block->d = 0x3c00; block->dmin = 0;
+            }
+        }
+        ((uint64_t *)addresses.contents)[selected[slot]] = weights[slot].gpuAddress;
+        for (unsigned i = 0; i < INPUT; i++)
+            ((float *)input.contents)[slot * INPUT + i] = (float)(slot + 1) / 16;
+        entries[slot].down_buffer = weights[slot];
+        entries[slot].valid = 1;
+        ptrs[slot] = &entries[slot];
+    }
+    for (unsigned c = 0; c < sizeof(counts) / sizeof(counts[0]) + 4; c++) {
+        const unsigned count = c < 5 ? counts[c] : 8;
+        int32_t route[8];
+        memcpy(route, selected, sizeof(route));
+        if (c == 5) route[7] = route[0]; /* Duplicate, still two logical slots. */
+        if (c == 6) route[7] = -1;
+        if (c == 7) route[7] = 288;
+        if (c == 8) ((uint64_t *)addresses.contents)[route[7]] = 0;
+        memcpy(ids.contents, route, sizeof(route));
+        ds4_gpu_mul_mv_id_args args = {
+            .nei0 = (int)count, .nei1 = 1, .nbi1 = count * 4,
+            .ne00 = INPUT, .ne01 = OUTPUT, .ne02 = 288,
+            .nb00 = 84, .nb01 = ROW_BYTES, .nb02 = OUTPUT * ROW_BYTES,
+            .ne10 = INPUT, .ne11 = (int)count, .ne12 = 1, .ne13 = 1,
+            .nb10 = 4, .nb11 = INPUT * 4, .nb12 = count * INPUT * 4,
+            .ne0 = OUTPUT, .ne1 = 1, .nb1 = OUTPUT * 4, .nr0 = 4,
+        };
+        int owned = 0;
+        id<MTLCommandBuffer> cb = ds4_gpu_command_buffer(&owned);
+        CHECK(cb);
+        ds4_gpu_mul_mv_id_args invalid = args;
+        invalid.nei0 = 9;
+        CHECK(!ds4_gpu_encode_mul_mv_addr_q2_sum6(cb,
+            g_moe_mul_mv_addr_q2_k_sum6_pipeline, &invalid, ptrs, count,
+            addresses, input, 0, output, 0, ids, 0, 0, 2, nil));
+        invalid.nei0 = 0;
+        CHECK(!ds4_gpu_encode_mul_mv_addr_q2_sum6(cb,
+            g_moe_mul_mv_addr_q2_k_sum6_pipeline, &invalid, ptrs, count,
+            addresses, input, 0, output, 0, ids, 0, 0, 2, nil));
+        CHECK(ds4_gpu_encode_mul_mv_addr_q2_sum6(cb,
+            g_moe_mul_mv_addr_q2_k_sum6_pipeline, &args, ptrs, count,
+            addresses, input, 0, output, 0, ids, 0, 0, 2, nil));
+        CHECK(ds4_gpu_finish_command_buffer(cb, owned, "Q2 address test"));
+        for (unsigned row = 0; row < OUTPUT; row++) {
+            float expected = 0;
+            for (unsigned slot = 0; slot < count; slot++) {
+                if (slot == 7 && c >= 6) continue;
+                unsigned weight_slot = slot == 7 && c == 5 ? 0 : slot;
+                expected += INPUT * (float)(slot + 1) / 16 * (1 + weight_slot % 3) * (1 + row % 4);
+            }
+            float actual = ((float *)output.contents)[row];
+            CHECK(isfinite(actual) && actual == expected);
+        }
+    }
+    puts("Q2 address: 1/2/6/7/8 experts, real 2048x4096 shape, nonuniform slot weights, exact CPU oracle: PASS");
+    puts("Q2 guards: host rejects 0/9 counts; kernel duplicate/invalid-ID/null-address guards: PASS (not session error atomicity)");
+}
+
+int main(void) {
+    @autoreleasepool {
+        CHECK(ds4_gpu_init());
+        check_device_predicate();
+        check_cache();
+        check_q2_address();
