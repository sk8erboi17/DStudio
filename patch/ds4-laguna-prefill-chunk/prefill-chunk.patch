+/*
+ * Laguna's prefill batch is also the row count of its preallocated graph
+ * scratch (laguna_graph_alloc).  The branch fixed it at 16384 rows.  On macOS
+ * one 16384-row Laguna layer at 16K-32K positions exceeds the GPU watchdog
+ * (kIOGPUCommandBufferCallbackErrorImpactingInteractivity), so a request for
+ * a smaller batch is honoured with the DeepSeek graph's precedence:
+ * --prefill-chunk, then DS4_METAL_PREFILL_CHUNK, then 4096 on Metal (the
+ * DeepSeek Flash long-prompt default in ds4_prefill_cap_for_prompt) and the
+ * original 16384 on other backends.  16384 stays selectable.  Larger batches
+ * (more scratch than the branch ever allocated) and batches smaller than one
+ * DFlash verifier block are refused, never clamped.  Every row keeps its
+ * absolute position; attention visits keys in causal order across batches.
+ */
+#define DS4_LAGUNA_PREFILL_CHUNK_MAX 16384u
+#define DS4_LAGUNA_METAL_PREFILL_CHUNK 4096u
+
+static uint32_t ds4_laguna_prefill_chunk(ds4_backend backend,
+                                         uint32_t    requested,
+                                         char       *err,
+                                         size_t      errlen) {
+    uint32_t chunk = requested;
+    const char *source = "--prefill-chunk";
+    if (chunk == 0) {
+        const char *env = getenv("DS4_METAL_PREFILL_CHUNK");
+        if (!env || !env[0]) {
+            return backend == DS4_BACKEND_METAL ?
+                DS4_LAGUNA_METAL_PREFILL_CHUNK : DS4_LAGUNA_PREFILL_CHUNK_MAX;
+        }
+        char *end = NULL;
+        const long long v = strtoll(env, &end, 10);
+        if (end == env || *end != '\0' || v <= 0 ||
+            v > (long long)DS4_LAGUNA_PREFILL_CHUNK_MAX) {
+            snprintf(err, errlen,
+                     "DS4_METAL_PREFILL_CHUNK=%s is not a Laguna prefill "
+                     "batch from %u to %u rows",
+                     env, (unsigned)DS4_DFLASH_BLOCK_SIZE,
+                     (unsigned)DS4_LAGUNA_PREFILL_CHUNK_MAX);
+            return 0;
+        }
+        chunk = (uint32_t)v;
+        source = "DS4_METAL_PREFILL_CHUNK";
+    }
+    if (chunk < DS4_DFLASH_BLOCK_SIZE || chunk > DS4_LAGUNA_PREFILL_CHUNK_MAX) {
+        snprintf(err, errlen,
+                 "%s %u is not a Laguna prefill batch from %u to %u rows",
+                 source, (unsigned)chunk, (unsigned)DS4_DFLASH_BLOCK_SIZE,
+                 (unsigned)DS4_LAGUNA_PREFILL_CHUNK_MAX);
+        return 0;
+    }
+    return chunk;
 }
 
+#ifdef DS4_TEST_HOOKS
+uint32_t ds4_test_laguna_prefill_chunk(int backend, uint32_t requested,
+                                       char *err, size_t errlen) {
+    return ds4_laguna_prefill_chunk((ds4_backend)backend, requested,
+                                    err, errlen);
+}
+#endif
