+// DStudio: DSTUDIO_CONTAIN_DIRECTORY=1 confines file tools to the session
+// directory itself, not the enclosing git worktree, and compares real paths
+// (the nearest existing ancestor is resolved) so a symlink inside the
+// directory cannot lead outside it. Unset, upstream behavior is unchanged.
+const directoryOnly = process.env.DSTUDIO_CONTAIN_DIRECTORY === "1"
+
+function realPath(target: string): string {
+  let probe = target
+  const tail: string[] = []
+  while (!fs.existsSync(probe)) {
+    const parent = path.dirname(probe)
+    if (parent === probe) break
+    tail.unshift(path.basename(probe))
+    probe = parent
+  }
+  try {
+    return path.join(fs.realpathSync(probe), ...tail)
+  } catch {
+    return target
+  }
+}
