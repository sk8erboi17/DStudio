+function registerExternalDs4Provider(pi: ExtensionAPI, apiBase: string): void {
+	const id = process.env.DS4_EXTERNAL_MODEL || "deepseek-v4-flash";
+	const contextWindow = SERVER_CONTEXT_TOKENS;
+	const baseUrl = PROVIDER_API === "anthropic-messages" ? apiBase.replace(/\/v1$/, "") : apiBase;
+	const model: Model<ProviderProtocol> = {
+		id,
+		name: process.env.DS4_EXTERNAL_MODEL_NAME || id,
+		api: PROVIDER_API,
+		provider: PROVIDER_ID,
+		baseUrl,
+		reasoning: true,
+		thinkingLevelMap: { off: "none", minimal: null, low: null, medium: null, high: "high", xhigh: null, max: "max" },
+		input: process.env.DS4_EXTERNAL_VISION === "1" ? ["text", "image"] : ["text"],
+		contextWindow,
+		maxTokens: Math.min(384_000, contextWindow),
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+		compat: modelCompat(),
+	};
+	const apiKey = process.env.DS4_API_KEY || "dsv4-local";
+	pi.registerProvider(
+		createProvider<ProviderProtocol>({
+			id: PROVIDER_ID,
+			name: "ds4.c (host-owned server)",
+			baseUrl,
+			auth: {
+				apiKey: {
+					name: "Local ds4 server",
+					async resolve() {
+						return { auth: { apiKey }, source: "host-owned ds4-server" };
+					},
+				},
+			},
+			models: [model],
+			api: protocolStreams(),
+		}),
+	);
+}
+
 export default async function (pi: ExtensionAPI) {
+	if (EXTERNAL_BASE_URL) {
+		registerExternalDs4Provider(pi, EXTERNAL_BASE_URL);
+		return;
+	}
 	runtimeDisposed = false;
 	shuttingDown = false;
 	leaseStartedAt = Date.now();
