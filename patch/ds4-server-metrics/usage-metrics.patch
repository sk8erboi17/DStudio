diff --git a/ds4_server.c b/ds4_server.c
--- a/ds4_server.c
+++ b/ds4_server.c
@@ -633,5 +633,8 @@ typedef struct {
     int cache_read_tokens;
     int cache_write_tokens;
+    /*DS4UI_SERVER_METRICS: exact decode timing exposed in OpenAI usage. */
+    double ds4_decode_tokens_per_second;
+    double ds4_decode_elapsed_seconds;
     ds4_think_mode think_mode;
     bool has_tools;
     bool prompt_preserves_reasoning;
@@ -5480,10 +5483,18 @@ static void append_openai_usage_json(buf *b, const request *r,
      * and must stay separate so OpenAI-compatible clients do not over-count
      * cache hits. */
     buf_printf(b,
                "{\"prompt_tokens\":%d,\"completion_tokens\":%d,\"total_tokens\":%d,"
