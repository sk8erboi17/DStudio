+                   r->ds4_decode_tokens_per_second,
+                   r->ds4_decode_elapsed_seconds);
+    }
+    buf_putc(b, '}');
 }
 
 static bool sse_usage_chunk(int fd, const request *r, const char *id,
@@ -11841,6 +11851,10 @@ decode_again:
     }
