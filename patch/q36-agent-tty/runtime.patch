diff --git a/q36_agent.c b/q36_agent.c
index 9391ef7..d8c603a 100644
--- a/q36_agent.c
+++ b/q36_agent.c
@@ -7219,6 +7219,7 @@ struct agent_bash_job {
     pid_t pid;
     int pipe_fd;
     int tty_fd;
+    int tty_hold_fd;
     int tmp_fd;
     char path[PATH_MAX];
     char *cmd;
@@ -7259,6 +7260,7 @@ static void agent_bash_job_free(agent_bash_job *job) {
     }
     if (job->pipe_fd >= 0) close(job->pipe_fd);
     if (job->tty_fd >= 0) close(job->tty_fd);
+    if (job->tty_hold_fd >= 0) close(job->tty_hold_fd);
     if (job->tmp_fd >= 0) close(job->tmp_fd);
     free(job->cmd);
     free(job);
@@ -7331,6 +7333,10 @@ static void agent_bash_finalize(agent_bash_job *job, int status) {
         close(job->tty_fd);
         job->tty_fd = -1;
     }
+    if (job->tty_hold_fd >= 0) {
+        close(job->tty_hold_fd);
+        job->tty_hold_fd = -1;
+    }
     if (WIFEXITED(status)) job->exit_status = WEXITSTATUS(status);
     else if (WIFSIGNALED(status)) job->exit_status = 128 + WTERMSIG(status);
     else job->exit_status = -1;
@@ -7406,6 +7412,10 @@ static void agent_bash_poll(agent_bash_job *job) {
             close(job->tty_fd);
             job->tty_fd = -1;
         }
+        if (job->tty_hold_fd >= 0) {
+            close(job->tty_hold_fd);
+            job->tty_hold_fd = -1;
+        }
         agent_worker_note_terminal_mode_may_have_changed(job->worker);
         return;
     }
@@ -7497,7 +7507,10 @@ static agent_bash_job *agent_bash_start(agent_worker *w, const char *cmd,
     }
 
     close(pipefd[1]);
-    if (slavefd >= 0) close(slavefd);
+    /* On macOS closing the last slave descriptor hangs up this private tty
+     * before a command can open /dev/tty. The job owner retains one CLOEXEC
+     * slave until reaping/cleanup; ordinary command stdin still receives EOF,
+     * and the command does not inherit this retained descriptor. */
     int old_flags;
     set_nonblock(pipefd[0], true, &old_flags);
     if (ttyfd >= 0) set_nonblock(ttyfd, true, NULL);
@@ -7509,6 +7522,7 @@ static agent_bash_job *agent_bash_start(agent_worker *w, const char *cmd,
     job->pid = pid;
     job->pipe_fd = pipefd[0];
     job->tty_fd = ttyfd;
+    job->tty_hold_fd = slavefd;
     job->tmp_fd = tmpfd;
     snprintf(job->path, sizeof(job->path), "%s", tmp_path);
     job->cmd = xstrdup(cmd);
