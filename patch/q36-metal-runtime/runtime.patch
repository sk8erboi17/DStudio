 #ifndef Q36_NO_GPU
+static bool q36_state_access_cancelled(const q36_payload_device_access *access) {
+    return access && access->cancelled && access->cancelled(access->userdata);
+}
+
+/* Private buffers do not own the backend command context. Borrow it only for
+ * one bounded transfer; driver allocation and disk I/O stay outside admission.
+ * Every admitted transfer is synchronous before returning the owner. */
+static int q36_state_tensor_write(const q36_payload_device_access *access,
+                                  q36_gpu_tensor *tensor, uint64_t offset,
+                                  const void *data, uint64_t bytes) {
+    if (q36_state_access_cancelled(access)) return Q36_SESSION_SYNC_INTERRUPTED;
+    if (access) {
+        int rc = access->enter(access->userdata);
+        if (rc) return rc;
+    }
+    int rc = q36_state_access_cancelled(access) ? Q36_SESSION_SYNC_INTERRUPTED :
+        q36_gpu_tensor_write(tensor, offset, data, bytes) ? 0 : 1;
+    if (access) access->leave(access->userdata);
+    return rc;
+}
