+static bool dstudio_owner_ready(int fd, int listener, q36_engine *engine, q36_session *session) {
+    if (fd == -1) return !g_stop_requested;
+    q36_engine_launch_info info;
+    struct sockaddr_in address;
+    socklen_t len = sizeof address;
+    char host[INET_ADDRSTRLEN], message[1536];
+    if (g_stop_requested || !session || !q36_engine_get_launch_info(engine, &info) ||
+        getsockname(listener, (struct sockaddr *)&address, &len) ||
+        address.sin_family != AF_INET ||
+        !inet_ntop(AF_INET, &address.sin_addr, host, sizeof host)) return false;
+    /* Fields come only from the loaded engine, opened file descriptors, actual
+     * session and bound socket. The model name is a native fixed family ID. */
+    int n = snprintf(message, sizeof message,
+        "{\"version\":1,\"event\":\"ready\",\"pid\":%ld,\"host\":\"%s\",\"port\":%u,"
+        "\"context\":%d,\"model\":\"%s\",\"backend\":\"%s\",\"cache_k\":\"%s\",\"cache_v\":\"%s\","
+        "\"ssd_streaming\":%s,\"model_file\":\"%s\",\"vision_file\":\"%s\",\"mtp_file\":\"%s\"}\n",
+        (long)getpid(), host, (unsigned)ntohs(address.sin_port), q36_session_ctx(session),
+        q36_engine_model_name(engine), q36_backend_name(info.backend),
+        q36_kv_cache_type_name(info.cache_k), q36_kv_cache_type_name(info.cache_v),
+        info.ssd_streaming ? "true" : "false", info.model_file, info.vision_file, info.mtp_file);
+    if (n <= 0 || (size_t)n >= sizeof message) return false;
+    size_t sent = 0;
+    while (sent < (size_t)n && !g_stop_requested) {
+        ssize_t wrote = write(fd, message + sent, (size_t)n - sent);
+        if (wrote < 0 && errno == EINTR) continue;
+        if (wrote <= 0) return false; /* never wait for an unresponsive owner */
+        sent += (size_t)wrote;
+    }
+    return sent == (size_t)n && !g_stop_requested;
 }
 
