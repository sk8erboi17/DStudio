+        return q36_session_sync(s, prompt, err, errlen);
+    }
+#ifdef Q36_NO_GPU
+    return 1;
+#else
+    /* Creation already zeroed the private runtime through bounded admissions.
+     * An empty valid prefix avoids another whole-runtime reset inside sync. */
+    s->checkpoint_valid = true;
+    uint32_t quantum = ((q36_vulkan_runtime *)s->runtime)->prefill_cap;
+    if (!quantum || !q36_payload_reserve_private(s, r, (uint32_t)prompt->len)) return 1;
+    q36_payload_device_access access = q36_payload_reader_access(r);
+    for (int done = 0; done < prompt->len;) {
+        q36_tokens prefix = *prompt;
+        int remaining = prompt->len - done;
+        prefix.len = done + (quantum < (uint32_t)remaining ? (int)quantum : remaining);
+        int rc = access.enter(access.userdata);
+        if (rc) return rc;
+        rc = q36_session_sync(s, &prefix, err, errlen);
+        if (!q36_gpu_synchronize() && !rc) rc = 1;
+        access.leave(access.userdata);
+        if (rc) return rc;
+        done = prefix.len;
+    }
+    return 0;
+#endif
+}
