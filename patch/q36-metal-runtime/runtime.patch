+static bool q36_state_tensor_zero(const q36_payload_device_access *access,
+                                 q36_gpu_tensor *tensor) {
+    if (!access) return q36_gpu_tensor_zero(tensor);
+    if (!tensor) return false;
+    const unsigned char zero[65536] = {0};
+    const uint64_t bytes = q36_gpu_tensor_bytes(tensor);
+    for (uint64_t off = 0; off < bytes;) {
+        uint64_t n = bytes - off > sizeof(zero) ? sizeof(zero) : bytes - off;
+        if (q36_state_tensor_write(access, tensor, off, zero, n)) return false;
+        off += n;
+    }
+    return true;
+}
