index 0000000..4186358
--- /dev/null
+++ b/metal/vision.metal
@@ -0,0 +1,57 @@
+#include <metal_stdlib>
+using namespace metal;
+
+// Qwen3-VL projector operations, adapted from the pinned q36 Vulkan kernels.
+// FP16 weights retain their values; activations and accumulation stay FP32.
+struct q36_vision_mm_args { uint in_dim, out_dim, rows; };
+
+kernel void q36_vision_matmul_f16(device const half *weights [[buffer(0)]],
+                                  device const float *x [[buffer(1)]],
+                                  device float *out [[buffer(2)]],
+                                  constant q36_vision_mm_args &args [[buffer(3)]],
+                                  uint2 group [[threadgroup_position_in_grid]],
+                                  uint2 lane [[thread_position_in_threadgroup]]) {
+    threadgroup float wt[16][16], xt[16][16];
+    uint o = group.x * 16u + lane.x, row = group.y * 16u + lane.y;
+    float sum = 0.0f;
+    for (uint base = 0; base < args.in_dim; base += 16u) {
+        uint kx = base + lane.y, ky = base + lane.x;
+        wt[lane.y][lane.x] = o < args.out_dim && kx < args.in_dim ?
+            float(weights[(ulong)o * args.in_dim + kx]) : 0.0f;
+        xt[lane.y][lane.x] = row < args.rows && ky < args.in_dim ?
+            x[(ulong)row * args.in_dim + ky] : 0.0f;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint k = 0; k < 16u; k++) sum += xt[lane.y][k] * wt[k][lane.x];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (row < args.rows && o < args.out_dim) out[(ulong)row * args.out_dim + o] = sum;
+}
+
+kernel void q36_vision_attention(device const float *qkv [[buffer(0)]],
+                                 device float *out [[buffer(1)]],
+                                 constant uint &rows [[buffer(2)]],
+                                 uint2 group [[threadgroup_position_in_grid]],
+                                 uint lane [[thread_index_in_threadgroup]]) {
+    threadgroup float dotv[128];
+    uint row = group.x, head = group.y;
+    ulong qbase = (ulong)row * 3456u + head * 72u;
+    float acc = 0.0f, high = 0.0f, denom = 0.0f;
+    for (uint kr = 0; kr < rows; kr++) {
+        ulong kbase = (ulong)kr * 3456u + 1152u + head * 72u;
+        dotv[lane] = lane < 72u ? qkv[qbase + lane] * qkv[kbase + lane] : 0.0f;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint stride = 64u; stride; stride >>= 1u) {
+            if (lane < stride) dotv[lane] += dotv[lane + stride];
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+        float score = dotv[0] * 0.1178511301977579f;
+        float next = kr == 0u ? score : max(high, score);
+        float old_scale = kr == 0u ? 0.0f : precise::exp(high - next);
+        float new_scale = precise::exp(score - next);
+        denom = denom * old_scale + new_scale;
+        if (lane < 72u) acc = acc * old_scale + new_scale * qkv[(ulong)kr * 3456u + 2304u + head * 72u + lane];
+        high = next;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (lane < 72u) out[(ulong)row * 1152u + head * 72u + lane] = acc / denom;
+}
