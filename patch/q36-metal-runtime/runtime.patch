+    if (s->batched_mode) {snprintf(err, errlen, "image requests require the single-session server"); return 1;}
+    q36_session *previous = slot->session, *candidate = NULL;
+    q36_tokens prompt = {0};
+    q36_vision_span *spans = NULL;
+    size_t count = j->req.images ? j->req.images->len : 0;
+    int rc = 1;
+    server_log(Q36_LOG_PREFILL, "q36-server: visual request preparation started images=%zu", count);
+    if (server_job_cancelled(j)) {rc = Q36_SESSION_SYNC_INTERRUPTED; goto done;}
+    if (count) {
+        rc = server_prepare_image_tokens(s, j, &prompt, &spans, err, errlen);
+        if (rc) goto done;
+    } else tokens_copy_prefix(&prompt, &j->req.prompt, j->req.prompt.len);
+    server_prefill_progress progress = {.kind = j->req.kind, .prompt_tokens = prompt.len,
+        .has_tools = j->req.has_tools, .t0 = now_sec()};
+    request_ctx_span(progress.ctx, sizeof(progress.ctx), 0, prompt.len);
+    /* No slot here: progress must not publish a private candidate to disk. */
+    if (count) {
+        if (q36_session_create(&candidate, s->engine, s->ctx_size)) {
+            snprintf(err, errlen, "unable to allocate private vision session; previous session retained");
+            rc = 1; goto done;
+        }
+        q36_session_set_cancel(candidate, server_job_cancelled, j);
+        q36_session_set_progress(candidate, server_progress_cb, &progress);
+        rc = q36_session_sync_vision(candidate, &prompt, spans, count, err, errlen);
+        q36_session_set_progress(candidate, NULL, NULL);
+        q36_session_set_cancel(candidate, NULL, NULL);
+    } else {
+        rc = q36_session_prepare_sync(&candidate, previous, &prompt,
+            server_progress_cb, &progress, server_job_cancelled, j, err, errlen);
+    }
+    if (rc) goto done;
+    if (server_job_cancelled(j)) {rc = Q36_SESSION_SYNC_INTERRUPTED; goto done;}
+    pthread_mutex_lock(&s->mu);
+    if (s->stopping || g_stop_requested || atomic_load(&j->cancelled) || slot->session != previous ||
+        q36_session_ctx(candidate) != s->ctx_size) {
+        pthread_mutex_unlock(&s->mu);
+        rc = Q36_SESSION_SYNC_INTERRUPTED; goto done;
+    }
+    slot->session = candidate;
+    slot->continued_last_store_tokens = 0;
+    pthread_mutex_unlock(&s->mu);
+    candidate = NULL;
+    q36_session_free(previous);
+    q36_tokens_free(&j->req.prompt);
+    j->req.prompt = prompt;
+    memset(&prompt, 0, sizeof(prompt));
+done:
+    if (rc == Q36_SESSION_SYNC_INTERRUPTED) snprintf(err, errlen, "vision request interrupted; previous session retained");
+    q36_session_free(candidate);
+    q36_tokens_free(&prompt);
+    server_vision_spans_free(spans, spans ? count : 0);
+    return rc;
+}
