+static bool q36_payload_reserve_private(q36_session *s, q36_payload_reader *r, uint32_t rows) {
+    if (!r->device || s->engine->backend == Q36_BACKEND_CPU)
+        return q36_session_reserve_kv(s, rows, 0);
