+static int server_prepare_tool_replay(server *s, job *j, char *err, size_t errlen) {
+    if (s->batched_mode || !j->req.tool_replay.missing_ids) return 0;
+    if (server_job_cancelled(j)) return Q36_SESSION_SYNC_INTERRUPTED;
+    if (!j->req.raw_body) {
+        snprintf(err, errlen, "tool replay requires the original request body");
+        return 1;
+    }
+    request prepared = {0};
+    bool ok = j->req.api == API_ANTHROPIC ?
+        parse_anthropic_request(s->engine, s, j->req.raw_body, s->default_tokens,
+                                s->ctx_size, &prepared, err, errlen) :
+        j->req.api == API_RESPONSES ?
+        parse_responses_request(s->engine, s, j->req.raw_body, s->default_tokens,
+                                s->ctx_size, &prepared, err, errlen) :
+        parse_chat_request(s->engine, s, j->req.raw_body, s->default_tokens,
+                            s->ctx_size, &prepared, err, errlen);
+    if (!ok) {request_free(&prepared); return 1;}
+    if (server_job_cancelled(j)) {
+        request_free(&prepared); return Q36_SESSION_SYNC_INTERRUPTED;
+    }
+    /* Only derived rendering moves. Sampling, stops, model, reasoning and the
+     * original body remain the request captured at admission. Image byte
+     * positions must move with the new rendered prefix, never independently. */
+    q36_tokens_free(&j->req.prompt);
+    free(j->req.prompt_text);
+    http_images_free(j->req.images);
+    j->req.prompt = prepared.prompt;
+    j->req.prompt_text = prepared.prompt_text;
+    j->req.images = prepared.images;
+    j->req.tool_replay = prepared.tool_replay;
+    j->req.prompt_preserves_reasoning = prepared.prompt_preserves_reasoning;
+    memset(&prepared.prompt, 0, sizeof(prepared.prompt));
+    prepared.prompt_text = NULL;
+    prepared.images = NULL;
+    request_free(&prepared);
+    return 0;
+}
