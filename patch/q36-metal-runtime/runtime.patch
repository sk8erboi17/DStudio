+    return false;
+#else
+    q36_vulkan_runtime *rt = s->runtime;
+    if (!rt || rows > (uint32_t)s->ctx_size) return false;
+    for (uint32_t il = 0; il <= Q36_N_LAYER; il++) {
+        if (q36_payload_read_cancelled(r)) return false;
+        if (il < Q36_N_LAYER && !q36_layer_is_full_attention(il)) continue;
+        if (il == Q36_N_LAYER && !rt->mtp_enabled) break;
+        q36_vulkan_full_attn_cache *c = il == Q36_N_LAYER ? &rt->mtp_full : &rt->full[il];
+        if (rows <= c->cap) continue;
+        uint32_t cap = q36_kv_next_cap(c->cap, rows, (uint32_t)s->ctx_size);
+        if (!cap || !q36_vulkan_cache_reserve(c, cap, 0, true)) return false;
+    }
+    return true;
+#endif
