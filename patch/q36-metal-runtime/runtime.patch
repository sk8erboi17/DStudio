+struct q36_mrope_args { uint heads; uint tokens; };
+
+// Same interleaved temporal/height/width positions and FP32 frequency
+// recurrence as vulkan/rope_qwen_mrope.comp. The remaining 192 dimensions
+// of each 256-wide head are deliberately untouched.
+kernel void q36_rope_qwen_mrope(device float *x [[buffer(0)]],
+                                device const uint *positions [[buffer(1)]],
+                                constant q36_mrope_args &args [[buffer(2)]],
+                                uint2 gid [[thread_position_in_grid]]) {
+    uint pair = gid.x & 31u;
+    uint head = gid.x >> 5u;
+    uint tok = gid.y;
+    if (head >= args.heads || tok >= args.tokens) return;
+    ulong base = ((ulong)tok * args.heads + head) * 256u;
+    float theta = float(positions[(ulong)tok * 3u + pair % 3u]);
+    float theta_scale = precise::pow(10000000.0f, -2.0f / 64.0f);
+    for (uint i = 0u; i < pair; i++) theta *= theta_scale;
+    // Fast trig loses range-reduction accuracy near 128k/256k positions;
+    // keep the long-position scalar tolerance without changing the recurrence.
+    float cs = precise::cos(theta), sn = precise::sin(theta);
+    float a = x[base + pair], b = x[base + pair + 32u];
+    x[base + pair] = a * cs - b * sn;
+    x[base + pair + 32u] = a * sn + b * cs;
+}
