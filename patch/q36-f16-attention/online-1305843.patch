+// F16 split attention: FP32 query/dot/softmax/value arithmetic. Each workgroup
+// visits at most 512 keys. Partial softmaxes merge online without changing KV.
+kernel void q36_attention_f16_online_split(
+        device float *partials [[buffer(0)]],
+        device const float *q [[buffer(1)]],
+        device const half *kcache [[buffer(2)]],
+        device const half *vcache [[buffer(3)]],
+        constant q36_attention_split_args &args [[buffer(4)]],
+        uint3 group_id [[threadgroup_position_in_grid]],
+        uint tid [[thread_index_in_threadgroup]],
+        uint lane [[thread_index_in_simdgroup]],
+        uint simdgroup [[simdgroup_index_in_threadgroup]]) {
+    const uint head = group_id.x, tok = group_id.y, span = group_id.z;
+    const uint count = args.pos0 + tok + 1u, first = span * 512u;
+    const uint last = min(count, first + 512u), n = last > first ? last - first : 0u;
+    const uint kvh = head / (args.heads / args.kv_heads);
+    device const float *qh = q + ((ulong)tok * args.heads + head) * args.dim;
+    threadgroup float weights[512], reduce[8];
+    // Preserve the original per-lane dot FMA/reduction order. Only the
+    // softmax/value reductions are reassociated, with tested error bounds.
+    float query[8];
+    for (uint i = 0; i < 8u; i++)
+        query[i] = lane + i * 32u < args.dim ? qh[lane + i * 32u] : 0.0f;
+    for (uint i = simdgroup; i < n; i += 8u) {
+        device const half *kh = kcache + ((ulong)(first + i) * args.kv_heads + kvh) * args.dim;
+        float dotv = 0.0f;
+        for (uint j = lane; j < args.dim; j += 32u)
+            dotv = fma(query[j / 32u], float(kh[j]), dotv);
+        dotv = simd_sum(dotv) * rsqrt(float(args.dim));
+        if (lane == 0u) weights[i] = dotv;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float m = -INFINITY;
+    for (uint i = tid; i < n; i += 256u) m = max(m, weights[i]);
+    m = simd_max(m);
+    if (lane == 0u) reduce[simdgroup] = m;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid == 0u) {
+        float value = reduce[0];
+        for (uint s = 1u; s < 8u; s++) value = max(value, reduce[s]);
+        reduce[0] = value;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    m = reduce[0];
+    float l = 0.0f;
+    for (uint i = tid; i < n; i += 256u) {
+        float w = exp(weights[i] - m); weights[i] = w; l += w;
+    }
+    l = simd_sum(l);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (lane == 0u) reduce[simdgroup] = l;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid == 0u) {
+        float value = reduce[0];
+        for (uint s = 1u; s < 8u; s++) value += reduce[s];
+        reduce[0] = value;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    ulong base = (((ulong)tok * args.heads + head) * args.n_spans + span) * (args.dim + 2u);
+    if (tid < args.dim) {
+        float acc = 0.0f;
+        for (uint i = 0; i < n; i++) {
+            device const half *vh = vcache + ((ulong)(first + i) * args.kv_heads + kvh) * args.dim;
+            acc = fma(weights[i], float(vh[tid]), acc);
+        }
+        partials[base + tid] = acc;
+    }
+    if (tid == 0u) { partials[base + args.dim] = m; partials[base + args.dim + 1u] = reduce[0]; }
+}
+
+// Reuse each F16 K/V load across the six Qwen27B queries sharing that KV
+// head. This is the same FP32 dot and online partial merge as the generic
+// path, with a bounded 18.5 KiB workgroup and 512 keys per workgroup.
+kernel void q36_attention_f16_gqa6(
+        device float *partials [[buffer(0)]],
+        device const float *q [[buffer(1)]],
+        device const half *kcache [[buffer(2)]],
+        device const half *vcache [[buffer(3)]],
+        constant q36_attention_split_args &args [[buffer(4)]],
+        uint3 group_id [[threadgroup_position_in_grid]],
+        uint tid [[thread_index_in_threadgroup]],
+        uint lane [[thread_index_in_simdgroup]],
+        uint simdgroup [[simdgroup_index_in_threadgroup]]) {
+    constexpr uint HQ = 6u;
+    const uint kvh = group_id.x, tok = group_id.y, span = group_id.z, head0 = kvh * HQ;
+    const uint count = args.pos0 + tok + 1u, first = span * 512u;
+    const uint last = min(count, first + 512u), n = last > first ? last - first : 0u;
+    threadgroup float queries[HQ * 256u], weights[HQ * 512u], reduce[8];
+    for (uint h = 0; h < HQ; h++) queries[h * 256u + tid] = q[((ulong)tok * args.heads + head0 + h) * 256u + tid];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float query[HQ][8];
+    for (uint h = 0; h < HQ; h++)
+        for (uint j = 0; j < 8; j++) query[h][j] = queries[h * 256u + lane + j * 32u];
+    for (uint i = simdgroup; i < n; i += 8u) {
+        device const half *kh = kcache + ((ulong)(first + i) * args.kv_heads + kvh) * 256u;
+        float dotv[HQ];
+        for (uint h = 0; h < HQ; h++) dotv[h] = 0.0f;
+        for (uint j = 0; j < 8; j++) {
+            float key = float(kh[lane + j * 32u]);
+            for (uint h = 0; h < HQ; h++) dotv[h] = fma(query[h][j], key, dotv[h]);
+        }
+        for (uint h = 0; h < HQ; h++) {
+            dotv[h] = simd_sum(dotv[h]) * rsqrt(256.0f);
+            if (lane == 0u) weights[h * 512u + i] = dotv[h];
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float maxima[HQ], sums[HQ], acc[HQ];
+    for (uint h = 0; h < HQ; h++) {
+        float m = -INFINITY;
+        for (uint i = tid; i < n; i += 256u) m = max(m, weights[h * 512u + i]);
+        m = simd_max(m);
+        if (lane == 0u) reduce[simdgroup] = m;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (tid == 0u) {
+            float value = reduce[0];
+            for (uint s = 1; s < 8; s++) value = max(value, reduce[s]);
+            reduce[0] = value;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        maxima[h] = reduce[0];
+        // All lanes must read reduce[0] before the next sum overwrites it.
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        float l = 0.0f;
+        for (uint i = tid; i < n; i += 256u) {
+            float w = exp(weights[h * 512u + i] - maxima[h]); weights[h * 512u + i] = w; l += w;
+        }
+        l = simd_sum(l);
+        if (lane == 0u) reduce[simdgroup] = l;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (tid == 0u) {
+            float value = reduce[0];
+            for (uint s = 1; s < 8; s++) value += reduce[s];
+            reduce[0] = value;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        sums[h] = reduce[0]; acc[h] = 0.0f;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    for (uint i = 0; i < n; i++) {
+        float value = float(vcache[((ulong)(first + i) * args.kv_heads + kvh) * 256u + tid]);
+        for (uint h = 0; h < HQ; h++) acc[h] = fma(weights[h * 512u + i], value, acc[h]);
+    }
+    for (uint h = 0; h < HQ; h++) {
+        ulong base = (((ulong)tok * args.heads + head0 + h) * args.n_spans + span) * 258u;
+        partials[base + tid] = acc[h];
+        if (tid == 0u) { partials[base + 256u] = maxima[h]; partials[base + 257u] = sums[h]; }
+    }
+}
+
+// Reuse each F16 K/V load across the six Qwen27B queries sharing that KV
+// head. This is the same FP32 dot and online partial merge as the generic
+// path, with a bounded 18.5 KiB workgroup and 512 keys per workgroup.
+kernel void q36_attention_f16_online_combine(
+        device float *out [[buffer(0)]],
+        device const float *partials [[buffer(1)]],
+        device const float *qg [[buffer(2)]],
+        device const float *sinks [[buffer(3)]],
+        constant q36_attention_split_args &args [[buffer(4)]],
+        uint2 group_id [[threadgroup_position_in_grid]],
+        uint tid [[thread_index_in_threadgroup]]) {
+    if (tid >= args.dim) return;
+    const uint head = group_id.x, tok = group_id.y;
+    const uint spans = (args.pos0 + tok + 512u) / 512u;
+    ulong base = ((ulong)tok * args.heads + head) * args.n_spans * (args.dim + 2u);
+    float acc = partials[base + tid], m = partials[base + args.dim], l = partials[base + args.dim + 1u];
+    for (uint span = 1; span < spans; span++) {
+        ulong row = base + (ulong)span * (args.dim + 2u);
+        float sm = partials[row + args.dim], sl = partials[row + args.dim + 1u];
+        float next_m = max(m, sm), r0 = exp(m - next_m), r1 = exp(sm - next_m);
+        acc = acc * r0 + partials[row + tid] * r1;
+        l = l * r0 + sl * r1; m = next_m;
+    }
+    if (args.has_sinks) {
+        float next_m = max(m, sinks[head]), r = exp(m - next_m);
+        acc *= r; l = l * r + exp(sinks[head] - next_m);
+    }
+    float g = qg[(ulong)tok * args.qg_stride + (ulong)head * args.dim * 2u + args.dim + tid];
+    float sigmoid = g >= 0.0f ? 1.0f / (1.0f + exp(-g)) : exp(g) / (1.0f + exp(g));
+    out[((ulong)tok * args.heads + head) * args.dim + tid] = acc * (l > 0.0f ? 1.0f / l : 1.0f) * sigmoid;
+}
