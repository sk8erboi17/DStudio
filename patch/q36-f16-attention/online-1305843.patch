+// Request-owned score scratch stores FP32 partials, at most 258 floats per
+// 512 keys. No new allocation/cache. Query tiles bound each submission to 8M
+// key/query/head pairs; individual workgroups never visit over 512 keys.
+static int q36_attention_f16_online(
+        q36_gpu_tensor *out, const q36_gpu_tensor *q,
+        const q36_gpu_tensor *qg, const q36_gpu_tensor *kcache,
+        const q36_gpu_tensor *vcache, q36_gpu_tensor *scores,
+        id<MTLBuffer> sinks, uint64_t sink_offset, bool has_sinks,
+        uint32_t pos0, uint32_t tokens, uint32_t heads,
+        uint32_t kv_heads, uint32_t dim) {
+    uint64_t end = (uint64_t)pos0 + tokens, pairs = (uint64_t)heads * end;
+    uint64_t capacity = (8u * 1024u * 1024u) / pairs;
+    if (!capacity) return 0; // Unbounded single-query configurations fail closed.
+    uint32_t tile = capacity < tokens ? (uint32_t)capacity : tokens;
+    const uint32_t spans = (uint32_t)((end + 511u) / 512u);
+    if ((uint64_t)tile * heads * spans * (dim + 2u) * sizeof(float) > scores->bytes) return 0;
+    if (!q36_metal_wait()) return 0;
+    for (uint32_t first = 0; first < tokens;) {
+        uint32_t count = tokens - first < tile ? tokens - first : tile;
+        uint64_t offset = (uint64_t)first * heads * dim * sizeof(float);
+        struct { uint32_t pos0, heads, kv_heads, dim, qg_stride, has_sinks, n_spans; }
+            args = {pos0 + first, heads, kv_heads, dim, heads * dim * 2u, has_sinks ? 1u : 0u, spans};
+        const bool gqa = heads == 24u && kv_heads == 4u && dim == 256u;
+        id<MTLComputeCommandEncoder> enc = q36_encoder(gqa ? @"q36_attention_f16_gqa6" : @"q36_attention_f16_online_split");
+        if (!enc) goto failed;
+        [enc setBuffer:scores->buffer offset:scores->offset atIndex:0];
+        [enc setBuffer:q->buffer offset:q->offset + offset atIndex:1];
+        [enc setBuffer:kcache->buffer offset:kcache->offset atIndex:2];
+        [enc setBuffer:vcache->buffer offset:vcache->offset atIndex:3];
+        [enc setBytes:&args length:sizeof(args) atIndex:4];
+        [enc dispatchThreadgroups:MTLSizeMake(gqa ? kv_heads : heads, count, spans) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+        [enc endEncoding];
+        enc = q36_encoder(@"q36_attention_f16_online_combine");
+        if (!enc) goto failed;
+        [enc setBuffer:out->buffer offset:out->offset + offset atIndex:0];
+        [enc setBuffer:scores->buffer offset:scores->offset atIndex:1];
+        [enc setBuffer:qg->buffer offset:qg->offset + offset * 2u atIndex:2];
+        [enc setBuffer:sinks offset:(NSUInteger)sink_offset atIndex:3];
+        [enc setBytes:&args length:sizeof(args) atIndex:4];
+        [enc dispatchThreadgroups:MTLSizeMake(heads, count, 1) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+        [enc endEncoding];
+        if (!q36_metal_wait()) goto failed;
+        first += count;
+    }
+    return 1;
+failed: {
+    // Discard only this inference owner's unsubmitted private work. Earlier
+    // submitted effects are not replayed, and session publication stays owned
+    // by the existing worker/transaction path.
+    __attribute__((objc_precise_lifetime)) id<MTLCommandBuffer> discard;
+    pthread_mutex_lock(&q36_mu);
+    discard = q36_batch; q36_batch = nil;
+    pthread_mutex_unlock(&q36_mu);
+    discard = nil;
+    return 0;
+}
+}
