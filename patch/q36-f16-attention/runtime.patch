+// Bounded F16 attention phases. The original kernel below is retained for
+// short contexts and as an independent single-query differential oracle.
+struct q36_f16_work_args {
+    uint pos0, heads, kv_heads, dim;
+    uint qg_stride, has_sinks, score_stride, start, span;
+};
+
+#define Q36_F16_WORK_BUFFERS \
+        device float *out [[buffer(0)]], \
+        device float *stats [[buffer(1)]], \
+        device float *scores [[buffer(2)]], \
+        device const float *q [[buffer(3)]], \
+        device const float *qg [[buffer(4)]], \
+        device const half *kcache [[buffer(5)]], \
+        device const half *vcache [[buffer(6)]], \
+        device const float *sinks [[buffer(7)]], \
+        constant q36_f16_work_args &args [[buffer(8)]]
+
+kernel void q36_attention_f16_scores_segment(
+        Q36_F16_WORK_BUFFERS,
+        uint2 group_id [[threadgroup_position_in_grid]],
+        uint lane [[thread_index_in_simdgroup]],
+        uint simdgroup [[simdgroup_index_in_threadgroup]]) {
+    uint head = group_id.x, tok = group_id.y;
+    uint count = args.pos0 + tok + 1u;
+    uint last = min(count, args.start + args.span);
+    uint kvh = head / (args.heads / args.kv_heads);
+    device const float *qh = q + ((ulong)tok * args.heads + head) * args.dim;
+    device float *sh = scores + (ulong)tok * args.score_stride +
+        (ulong)head * (args.score_stride / args.heads);
+    float scale = rsqrt(float(args.dim));
+    // Each lane reuses the same query for all keys in this segment. Keep its
+    // at-most-eight elements in registers; retain the original lane/FMA order.
+    float query[8];
+    #pragma unroll
+    for (uint i = 0; i < 8u; i++)
+        query[i] = lane + i * 32u < args.dim ? qh[lane + i * 32u] : 0.0f;
+    for (uint pos = args.start + simdgroup; pos < last; pos += 8u) {
+        device const half *kh = kcache + ((ulong)pos * args.kv_heads + kvh) * args.dim;
+        float key[8];
+        #pragma unroll
+        for (uint i = 0; i < 8u; i++)
+            key[i] = lane + i * 32u < args.dim ? float(kh[lane + i * 32u]) : 0.0f;
+        float dotv = 0.0f;
+        #pragma unroll
+        for (uint i = 0; i < 8u; i++) {
+            if (lane + i * 32u < args.dim) dotv = fma(query[i], key[i], dotv);
+        }
+        dotv = simd_sum(dotv) * scale;
+        if (lane == 0u) sh[pos] = dotv;
+    }
+}
+
+kernel void q36_attention_f16_max_segment(
+        Q36_F16_WORK_BUFFERS,
+        uint2 group_id [[threadgroup_position_in_grid]]) {
+    uint head = group_id.x, tok = group_id.y, count = args.pos0 + tok + 1u;
+    if (args.start >= count) return;
+    ulong slot = ((ulong)tok * args.heads + head) * 2u;
+    device const float *sh = scores + (ulong)tok * args.score_stride +
+        (ulong)head * (args.score_stride / args.heads);
+    float value = args.start ? stats[slot] : (args.has_sinks ? sinks[head] : -INFINITY);
+    for (uint pos = args.start; pos < min(count, args.start + args.span); pos++)
+        value = max(value, sh[pos]);
+    stats[slot] = value;
+}
+
+kernel void q36_attention_f16_weights_segment(
+        Q36_F16_WORK_BUFFERS,
+        uint2 group_id [[threadgroup_position_in_grid]]) {
+    uint head = group_id.x, tok = group_id.y, count = args.pos0 + tok + 1u;
+    if (args.start >= count) return;
+    ulong slot = ((ulong)tok * args.heads + head) * 2u;
+    device float *sh = scores + (ulong)tok * args.score_stride +
+        (ulong)head * (args.score_stride / args.heads);
+    float maxv = stats[slot];
+    float denom = args.start ? stats[slot + 1u] :
+        (args.has_sinks ? exp(sinks[head] - maxv) : 0.0f);
+    uint last = min(count, args.start + args.span);
+    // Keep the original left-to-right FP32 sum, including sink initialization.
+    for (uint pos = args.start; pos < last; pos++) {
+        sh[pos] = exp(sh[pos] - maxv);
+        denom += sh[pos];
+    }
+    stats[slot + 1u] = last == count ? (denom > 0.0f ? 1.0f / denom : 1.0f) : denom;
+}
+
+kernel void q36_attention_f16_values_segment(
+        Q36_F16_WORK_BUFFERS,
+        uint2 group_id [[threadgroup_position_in_grid]],
+        uint tid [[thread_index_in_threadgroup]]) {
+    uint head = group_id.x, tok = group_id.y, count = args.pos0 + tok + 1u;
+    if (args.start >= count) return;
+    uint kvh = head / (args.heads / args.kv_heads);
+    device const float *sh = scores + (ulong)tok * args.score_stride +
+        (ulong)head * (args.score_stride / args.heads);
+    uint last = min(count, args.start + args.span);
+    threadgroup float weights[1024];
+    for (uint i = tid; i < last - args.start; i += 256u)
+        weights[i] = sh[args.start + i];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid >= args.dim) return;
+    ulong index = ((ulong)tok * args.heads + head) * args.dim + tid;
+    float value = args.start ? out[index] : 0.0f;
+    uint pos = args.start;
+    // Independent reads may overlap, but the FMA chain remains left-to-right.
+    // The scalar tail preserves the exact causal frontier on partial segments.
+    for (; last - pos >= 8u; pos += 8u) {
+        ulong base = ((ulong)pos * args.kv_heads + kvh) * args.dim + tid;
+        ulong stride = (ulong)args.kv_heads * args.dim;
+        float v0 = float(vcache[base]);
+        float v1 = float(vcache[base + stride]);
+        float v2 = float(vcache[base + 2u * stride]);
+        float v3 = float(vcache[base + 3u * stride]);
+        float v4 = float(vcache[base + 4u * stride]);
+        float v5 = float(vcache[base + 5u * stride]);
+        float v6 = float(vcache[base + 6u * stride]);
+        float v7 = float(vcache[base + 7u * stride]);
+        uint w = pos - args.start;
+        value = fma(weights[w], v0, value);
+        value = fma(weights[w + 1u], v1, value);
+        value = fma(weights[w + 2u], v2, value);
+        value = fma(weights[w + 3u], v3, value);
+        value = fma(weights[w + 4u], v4, value);
+        value = fma(weights[w + 5u], v5, value);
+        value = fma(weights[w + 6u], v6, value);
+        value = fma(weights[w + 7u], v7, value);
+    }
+    for (; pos < last; pos++) {
+        device const half *vh = vcache + ((ulong)pos * args.kv_heads + kvh) * args.dim;
+        value = fma(weights[pos - args.start], float(vh[tid]), value);
+    }
+    if (last == count) {
+        float g = qg[(ulong)tok * args.qg_stride + (ulong)head * args.dim * 2u + args.dim + tid];
+        float sigmoid = g >= 0.0f ? 1.0f / (1.0f + exp(-g)) : exp(g) / (1.0f + exp(g));
+        value = value * stats[((ulong)tok * args.heads + head) * 2u + 1u] * sigmoid;
+    }
+    out[index] = value;
+}
+#undef Q36_F16_WORK_BUFFERS
