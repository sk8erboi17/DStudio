+// Private per-call reduction state: two FP32 values per query/head, <=64 KiB.
+// The inference owner retains inputs/output throughout both ordered passes.
+// Partial output is never a committed session; errors stop, not replay, work.
+static int q36_attention_f16_bounded(
+        q36_gpu_tensor *out, const q36_gpu_tensor *q,
+        const q36_gpu_tensor *qg, const q36_gpu_tensor *kcache,
+        const q36_gpu_tensor *vcache, q36_gpu_tensor *scores,
+        id<MTLBuffer> sinks, uint64_t sink_offset, bool has_sinks,
+        uint32_t pos0, uint32_t tokens, uint32_t heads,
+        uint32_t kv_heads, uint32_t dim, uint32_t score_stride) {
+    const uint32_t key_span = 1024u, max_query_heads = 8192u;
+    if (heads > max_query_heads) return 0;
+    uint32_t tile = max_query_heads / heads;
+    if (tile > tokens) tile = tokens;
+    q36_gpu_tensor *stats = q36_gpu_tensor_alloc((uint64_t)tile * heads * 2u * sizeof(float));
+    if (!stats) return 0;
+    int ok = 0;
+    // Drain preceding Q/K/V writes before reusing scratch. No driver wait or
+    // tensor allocation/free occurs while the publication mutex is held.
+    if (!q36_metal_wait()) goto done;
+    for (uint32_t first = 0; first < tokens;) {
+        uint32_t count = tokens - first < tile ? tokens - first : tile;
+        uint32_t end = pos0 + first + count;
+        uint64_t offset = (uint64_t)first * heads * dim * sizeof(float);
+        struct {
+            uint32_t pos0, heads, kv_heads, dim;
+            uint32_t qg_stride, has_sinks, score_stride, start, span;
+        } args = {pos0 + first, heads, kv_heads, dim, heads * dim * 2u,
+                  has_sinks ? 1u : 0u, score_stride, 0, 0};
+        // Pass 0 produces scores and the ordered maximum. Pass 1 produces
+        // weights, the ordered denominator and the ordered value FMA chain.
+        // Every command visits at most 1024 keys and 8192 query/head pairs.
+        for (unsigned phase = 0; phase < 2; phase++) {
+            for (uint32_t start = 0; start < end;) {
+                args.start = start;
+                args.span = end - start < key_span ? end - start : key_span;
+                for (unsigned stage = 0; stage < 2; stage++) {
+                    NSString *kernel = phase == 0 ?
+                        (stage == 0 ? @"q36_attention_f16_scores_segment" : @"q36_attention_f16_max_segment") :
+                        (stage == 0 ? @"q36_attention_f16_weights_segment" : @"q36_attention_f16_values_segment");
+                    id<MTLComputeCommandEncoder> enc = q36_encoder(kernel);
+                    if (!enc) goto done;
+                    [enc setBuffer:out->buffer offset:out->offset + offset atIndex:0];
+                    [enc setBuffer:stats->buffer offset:stats->offset atIndex:1];
+                    [enc setBuffer:scores->buffer offset:scores->offset atIndex:2];
+                    [enc setBuffer:q->buffer offset:q->offset + offset atIndex:3];
+                    [enc setBuffer:qg->buffer offset:qg->offset + offset * 2u atIndex:4];
+                    [enc setBuffer:kcache->buffer offset:kcache->offset atIndex:5];
+                    [enc setBuffer:vcache->buffer offset:vcache->offset atIndex:6];
+                    [enc setBuffer:sinks offset:(NSUInteger)sink_offset atIndex:7];
+                    [enc setBytes:&args length:sizeof(args) atIndex:8];
+                    uint32_t threads = (phase == 0 ? stage == 0 : stage == 1) ? 256u : 1u;
+                    [enc dispatchThreadgroups:MTLSizeMake(heads, count, 1)
+                        threadsPerThreadgroup:MTLSizeMake(threads, 1, 1)];
+                    [enc endEncoding];
+                }
+                if (!q36_metal_wait()) goto done;
+                start += args.span;
+            }
+        }
+        first += count;
+    }
+    ok = 1;
+done:
+    if (!ok) {
+        // If encoder creation failed mid-command, discard only this owner's
+        // unsubmitted preparation. A failed submitted buffer is already reaped.
+        __attribute__((objc_precise_lifetime)) id<MTLCommandBuffer> discard;
+        pthread_mutex_lock(&q36_mu);
+        discard = q36_batch; q36_batch = nil;
+        pthread_mutex_unlock(&q36_mu);
+        discard = nil;
+    }
+    q36_gpu_tensor_free(stats);
+    return ok;
+}
