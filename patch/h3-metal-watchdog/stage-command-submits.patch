+static int submit_dit_stage(h3_dit *dit, const char *submit_operation,
+                            const char *begin_operation, char *error,
+                            size_t error_size) {
+    if (!getenv("H3_DIT_STAGE_SUBMITS")) return 1;
+    int trace = getenv("H3_DIT_STAGE_TRACE") != NULL;
+    if (trace) {
+        fprintf(stderr, "\nh3 DiT stage: %s\n", submit_operation);
+        fflush(stderr);
+    }
+    int ok = gpu_op(dit, h3_gpu_submit(dit->gpu), error, error_size,
+                    submit_operation) &&
+             gpu_op(dit, h3_gpu_begin(dit->gpu), error, error_size,
+                    begin_operation);
+    if (trace && ok) {
+        fprintf(stderr, "h3 DiT stage complete: %s\n", submit_operation);
+        fflush(stderr);
+    }
+    return ok;
+}
