+static uint32_t h3_gpu_sdpa_query_chunk(uint32_t sequence, int causal,
+                                        int headMajor, int outputHeadMajor,
+                                        h3_gpu_dtype tensor_dtype) {
+    const char *value = getenv("H3_SDPA_QUERY_CHUNK");
+    if (!value || !*value || causal || headMajor || outputHeadMajor ||
+        tensor_dtype != H3_GPU_BF16) return 0;
+    char *end = NULL;
+    unsigned long parsed = strtoul(value, &end, 10);
+    if (end == value || *end || parsed < 1 || parsed >= sequence ||
+        parsed > UINT32_MAX) return 0;
+    return (uint32_t)parsed;
+}
