+static int h3_gpu_sdpa_encode(H3GPU *gpu, h3_gpu_tensor *output,
+                              const h3_gpu_tensor *query,
+                              const h3_gpu_tensor *key,
+                              const h3_gpu_tensor *value, uint32_t batch,
+                              uint32_t query_sequence,
+                              uint32_t key_value_sequence, uint32_t heads,
+                              uint32_t head_dim, float scale,
+                              MPSDataType mps_dtype, int causal,
+                              int headMajor, int outputHeadMajor) {
+    H3SDPA *cache = h3_gpu_sdpa_graph(
+        gpu, batch, query_sequence, key_value_sequence, heads, head_dim,
+        scale, mps_dtype, causal, headMajor, outputHeadMajor);
+    if (!cache) return 0;
+    @autoreleasepool {
+        MPSCommandBuffer *command = h3_gpu_mps_command(gpu);
+        MPSGraphTensorData *queryData = h3_gpu_graph_data(
+            query, cache.queryShape, mps_dtype, 0);
+        MPSGraphTensorData *keyData = h3_gpu_graph_data(
+            key, cache.keyValueShape, mps_dtype, 0);
+        MPSGraphTensorData *valueData = h3_gpu_graph_data(
+            value, cache.keyValueShape, mps_dtype, 0);
+        MPSGraphTensorData *outputData = h3_gpu_graph_data(
+            output, cache.outputShape, mps_dtype, 0);
+        NSDictionary *feeds = @{
+            cache.query: queryData, cache.key: keyData, cache.value: valueData
+        };
+        NSDictionary *results = @{cache.output: outputData};
+        @try {
+            [cache.graph encodeToCommandBuffer:command feeds:feeds
+                targetOperations:nil resultsDictionary:results
+                executionDescriptor:nil];
+        } @catch (NSException *exception) {
+            h3_gpu_set_error(gpu, @"MPSGraph SDPA failed: %@", exception.reason);
+            return 0;
+        }
+        gpu.command = command.rootCommandBuffer;
+    }
+    h3_gpu_stats stats = gpu.stats;
+    stats.mps_sdpa_dispatches++;
+    gpu.stats = stats;
+    return 1;
+}
