diff --git a/ds4.c b/ds4.c
--- a/ds4.c
+++ b/ds4.c
@@ -59599,6 +59599,261 @@
 static double g_q35_eval_cpu_accum;
 double qwen35_eval_cpu_ms(void) { return g_q35_eval_cpu_accum; }
 
+#if defined(__APPLE__) && !defined(DS4_NO_GPU)
+/* One inference owner, one bounded chunk, no cache or additional worker.
+ * FP32 activations, Q6_K/Q8_0 weights and F16 KV retain decode semantics.
+ * Recurrent state and logits are private until the completed chunk commits.
+ * Fresh histories also prepare a private KV pair, capped at 4 GiB; appended
+ * histories write only beyond the previously committed physical frontier. */
+typedef struct {
+    ds4_gpu_tensor *x, *normed, *proj, *qkv, *qkv_silu, *z, *alpha, *beta;
+    ds4_gpu_tensor *gdn_out, *q, *kraw, *vraw, *attn_out;
+    ds4_gpu_tensor *sel, *sel_w, *n_sel, *moe_mid, *moe_partial, *sgate;
+    ds4_gpu_tensor *gdn_state, *conv_state, *acc, *logits, *kcache, *vcache;
+    float *host_logits;
+    bool fresh;
+} qwen35_prefill;
+
+static bool ds4_session_cancelled(ds4_session *s);
+
+static void qwen35_prefill_free(qwen35_prefill *p) {
+    ds4_gpu_tensor *t[] = {p->x,p->normed,p->proj,p->qkv,p->qkv_silu,p->z,p->alpha,p->beta,
+        p->gdn_out,p->q,p->kraw,p->vraw,p->attn_out,p->sel,p->sel_w,p->n_sel,
+        p->moe_mid,p->moe_partial,p->sgate,p->gdn_state,p->conv_state,p->acc,
+        p->logits,p->kcache,p->vcache};
+    for (size_t i = 0; i < sizeof(t)/sizeof(t[0]); i++) ds4_gpu_tensor_free(t[i]);
+    free(p->host_logits); memset(p,0,sizeof(*p));
+}
+
+static int qwen35_prefill_alloc(qwen35_prefill *p, ds4_session *s, bool fresh) {
+    const uint64_t n = 64, f = sizeof(float), emb = DS4_N_EMBD;
+    const uint64_t kv_limit=4ull*1024u*1024u*1024u;
+    uint64_t kb=ds4_gpu_tensor_bytes(s->q35_k_cache), vb=ds4_gpu_tensor_bytes(s->q35_v_cache);
+    if (!kb || !vb || vb>kv_limit || kb>kv_limit-vb) return 0;
+    const uint64_t conv = (2u * DS4_N_SSM_GROUP + DS4_N_SSM_DT_RANK) * DS4_N_SSM_STATE;
+    const uint64_t gdn = (uint64_t)DS4_N_SSM_DT_RANK * DS4_N_SSM_STATE;
+    const uint64_t q = (uint64_t)DS4_N_HEAD * DS4_N_HEAD_DIM, kv = (uint64_t)DS4_N_HEAD_KV * DS4_N_HEAD_DIM;
+    struct { ds4_gpu_tensor **out; uint64_t bytes; } buffers[] = {
+        {&p->x,n*emb*f},{&p->normed,n*emb*f},{&p->proj,n*emb*f},
+        {&p->qkv,n*(conv > 2*q ? conv : 2*q)*f},{&p->qkv_silu,n*conv*f},
+        {&p->z,n*gdn*f},{&p->alpha,n*DS4_N_SSM_DT_RANK*f},{&p->beta,n*DS4_N_SSM_DT_RANK*f},
+        {&p->gdn_out,n*gdn*f},{&p->q,n*q*f},{&p->kraw,n*kv*f},{&p->vraw,n*kv*f},{&p->attn_out,n*q*f},
+        {&p->sel,n*DS4_N_EXPERT_USED*sizeof(int32_t)},{&p->sel_w,n*DS4_N_EXPERT_USED*f},
+        {&p->n_sel,n*sizeof(uint32_t)},{&p->sgate,n*f},
+        {&p->moe_mid,n*(DS4_N_EXPERT_USED+1u)*DS4_N_FF_EXP*f},
+        {&p->moe_partial,n*(DS4_N_EXPERT_USED+1u)*emb*f},
+        {&p->gdn_state,ds4_gpu_tensor_bytes(s->q35_gdn_state)},
+        {&p->conv_state,ds4_gpu_tensor_bytes(s->q35_conv_state)},
+        {&p->acc,((uint64_t)DS4_N_LAYER+1u)*sizeof(uint32_t)},
+        {&p->logits,(uint64_t)DS4_N_VOCAB*f}
+    };
+    uint64_t total = (uint64_t)DS4_N_VOCAB*f;
+    if (total>128u*1024u*1024u) return 0;
+    for (size_t i=0;i<sizeof(buffers)/sizeof(buffers[0]);i++) {
+        if (!buffers[i].bytes || buffers[i].bytes > 128u*1024u*1024u-total) return 0;
+        total += buffers[i].bytes;
+    }
+    for (size_t i=0;i<sizeof(buffers)/sizeof(buffers[0]);i++)
+        if (!(*buffers[i].out=ds4_gpu_tensor_alloc(buffers[i].bytes))) return 0;
+    p->host_logits=malloc((size_t)DS4_N_VOCAB*f); if (!p->host_logits) return 0;
+    p->fresh=fresh;
+    if (fresh) {
+        p->kcache=ds4_gpu_tensor_alloc(kb); p->vcache=ds4_gpu_tensor_alloc(vb);
+        if (!ds4_gpu_tensor_fill_f32(p->gdn_state,0,ds4_gpu_tensor_bytes(p->gdn_state)/f) ||
+            !ds4_gpu_tensor_fill_f32(p->conv_state,0,ds4_gpu_tensor_bytes(p->conv_state)/f) ||
+            !ds4_gpu_tensor_fill_f32(p->acc,0,DS4_N_LAYER+1u)) return 0;
+    } else {
+        p->kcache=ds4_gpu_tensor_view(s->q35_k_cache,0,kb); p->vcache=ds4_gpu_tensor_view(s->q35_v_cache,0,vb);
+    }
+    return p->kcache && p->vcache;
+}
+
+static int qwen35_project_rows(ds4_gpu_tensor *out, ds4_engine *e, const ds4_tensor *w,
+                               uint32_t in, uint32_t n_out, ds4_gpu_tensor *x, uint32_t rows) {
+    if (w->type==DS4_TENSOR_Q6_K)
+        return ds4_gpu_qwen35_matvec_q6_k_rows_tensor(out,e->model.map,e->model.size,w->abs_offset,in,n_out,x,rows);
+    if (w->type==DS4_TENSOR_F32)
+        return ds4_gpu_qwen35_matvec_f32_rows_tensor(out,e->model.map,e->model.size,w->abs_offset,in,n_out,x,rows);
+    if (w->type==DS4_TENSOR_Q8_0)
+        return ds4_gpu_matmul_q8_0_decode_rows_exact_tensor(out,e->model.map,e->model.size,w->abs_offset,in,n_out,x,rows);
+    return 0;
+}
+
+// Split long-context attention into bounded query submissions. KV and all
+// outputs belong to this unfinished candidate; a tile never commits a session.
+static int qwen35_prefill_attention(ds4_session *s, qwen35_prefill *p,
+                                    ds4_gpu_tensor *k, ds4_gpu_tensor *v,
+                                    uint32_t pos, uint32_t count) {
+    const uint64_t row=(uint64_t)DS4_N_HEAD*DS4_N_HEAD_DIM*sizeof(float);
+    const uint64_t pairs=(uint64_t)DS4_N_HEAD*((uint64_t)pos+count);
+    const uint64_t cap=8u*1024u*1024u/pairs;
+    if (!cap || !ds4_gpu_end_commands() || !ds4_gpu_begin_commands()) return 0;
+    for (uint32_t first=0;first<count;) {
+        if (ds4_session_cancelled(s)) return 0;
+        uint32_t n=count-first; if (n>cap) n=(uint32_t)cap;
+        ds4_gpu_tensor *q=ds4_gpu_tensor_view(p->q,(uint64_t)first*row,n*row);
+        ds4_gpu_tensor *gate=ds4_gpu_tensor_view(p->qkv,(uint64_t)first*row*2u,n*row*2u);
+        ds4_gpu_tensor *out=ds4_gpu_tensor_view(p->attn_out,(uint64_t)first*row,n*row);
+        int ok=q && gate && out && ds4_gpu_qwen35_attn_rows_tensor(q,gate,k,v,out,pos+first+1u,
+            DS4_N_HEAD_DIM,DS4_N_HEAD,DS4_N_HEAD_KV,1.0f/sqrtf((float)DS4_N_HEAD_DIM),n);
+        ds4_gpu_tensor_free(q);ds4_gpu_tensor_free(gate);ds4_gpu_tensor_free(out);
+        if (!ok || !ds4_gpu_end_commands() || !ds4_gpu_begin_commands()) return 0;
+        first+=n;
+    }
+    return 1;
+}
+
+static int qwen35_prefill_chunk(ds4_session *s, qwen35_prefill *p, const int *tokens,
+                                uint32_t pos, uint32_t count) {
+    ds4_engine *e=s->engine; const void *mm=e->model.map; const uint64_t ms=e->model.size;
+    const uint32_t emb=DS4_N_EMBD, gd=DS4_N_SSM_DT_RANK*DS4_N_SSM_STATE;
+    const uint32_t conv=(2u*DS4_N_SSM_GROUP+DS4_N_SSM_DT_RANK)*DS4_N_SSM_STATE;
+    const uint32_t qd=DS4_N_HEAD*DS4_N_HEAD_DIM, kvd=DS4_N_HEAD_KV*DS4_N_HEAD_DIM;
+    const uint64_t f=sizeof(float), kvrow=(uint64_t)kvd*sizeof(uint16_t);
+    if (!count || count>64 || !ds4_gpu_begin_commands()) return 0;
+    int ok=0;
+#define Q35_CHECK(expr) do { if (!(expr)) goto done; } while(0)
+    if (!p->fresh) {
+        Q35_CHECK(ds4_gpu_tensor_copy(p->gdn_state,0,s->q35_gdn_state,0,ds4_gpu_tensor_bytes(p->gdn_state)));
+        Q35_CHECK(ds4_gpu_tensor_copy(p->conv_state,0,s->q35_conv_state,0,ds4_gpu_tensor_bytes(p->conv_state)));
+        Q35_CHECK(ds4_gpu_tensor_copy(p->acc,0,s->q35_n_sel_acc,0,ds4_gpu_tensor_bytes(p->acc)));
+    }
+    for (uint32_t t=0;t<count;t++) {
+        ds4_gpu_tensor *row=ds4_gpu_tensor_view(p->x,(uint64_t)t*emb*f,emb*f);
+        if (!row) goto done;
+        int embedded=e->weights.token_embd->type==DS4_TENSOR_Q6_K
+            ? ds4_gpu_qwen35_embed_q6_k_tensor(row,mm,ms,e->weights.token_embd->abs_offset,DS4_N_VOCAB,tokens[t],emb)
+            : ds4_gpu_embed_token_quant_tensor(row,mm,ms,e->weights.token_embd->abs_offset,e->weights.token_embd->type,DS4_N_VOCAB,tokens[t],emb);
+        ds4_gpu_tensor_free(row); Q35_CHECK(embedded);
+    }
+    for (uint32_t il=0;il<DS4_N_LAYER;il++) {
+        if (ds4_session_cancelled(s)) goto done;
+        const ds4_layer_weights *l=&e->weights.layer[il];
+        Q35_CHECK(ds4_gpu_rms_norm_weight_rows_tensor(p->normed,p->x,mm,ms,l->attn_norm->abs_offset,emb,count,DS4_RMS_EPS));
+        if (qwen35_layer_is_attn(il)) {
+            uint64_t base=(uint64_t)qwen35_attn_index(il)*s->ctx_size*kvrow;
+            ds4_gpu_tensor *k=ds4_gpu_tensor_view(p->kcache,base,(uint64_t)s->ctx_size*kvrow);
+            ds4_gpu_tensor *v=ds4_gpu_tensor_view(p->vcache,base,(uint64_t)s->ctx_size*kvrow);
+            int branch=k && v &&
+                qwen35_project_rows(p->qkv,e,l->attn_q,emb,2u*qd,p->normed,count) &&
+                qwen35_project_rows(p->kraw,e,l->attn_k,emb,kvd,p->normed,count) &&
+                qwen35_project_rows(p->vraw,e,l->attn_v,emb,kvd,p->normed,count) &&
+                ds4_gpu_qwen35_norm_rope_rows_tensor(p->qkv,mm,ms,l->attn_q_norm->abs_offset,p->q,NULL,0,
+                    DS4_N_HEAD,DS4_N_HEAD_DIM,DS4_N_ROT,2u*DS4_N_HEAD_DIM,0,0,pos,DS4_ROPE_FREQ_BASE,DS4_RMS_EPS,count) &&
+                ds4_gpu_qwen35_norm_rope_rows_tensor(p->kraw,mm,ms,l->attn_k_norm->abs_offset,NULL,k,(uint64_t)pos*kvrow,
+                    DS4_N_HEAD_KV,DS4_N_HEAD_DIM,DS4_N_ROT,DS4_N_HEAD_DIM,0,1,pos,DS4_ROPE_FREQ_BASE,DS4_RMS_EPS,count) &&
+                ds4_gpu_qwen35_v_store_f16_tensor(p->vraw,p->vcache,base+(uint64_t)pos*kvrow,count*kvd) &&
+                qwen35_prefill_attention(s,p,k,v,pos,count) &&
+                qwen35_project_rows(p->proj,e,l->attn_output,qd,emb,p->attn_out,count);
+            ds4_gpu_tensor_free(k); ds4_gpu_tensor_free(v); Q35_CHECK(branch);
+        } else {
+            uint64_t gb=(uint64_t)gd*DS4_N_SSM_STATE*f, cb=(uint64_t)(DS4_N_SSM_CONV-1u)*conv*f;
+            ds4_gpu_tensor *g=ds4_gpu_tensor_view(p->gdn_state,(uint64_t)qwen35_gdn_index(il)*gb,gb);
+            ds4_gpu_tensor *c=ds4_gpu_tensor_view(p->conv_state,(uint64_t)qwen35_gdn_index(il)*cb,cb);
+            int branch=g && c &&
+                qwen35_project_rows(p->qkv,e,l->attn_qkv,emb,conv,p->normed,count) &&
+                qwen35_project_rows(p->z,e,l->attn_gate,emb,gd,p->normed,count) &&
+                qwen35_project_rows(p->alpha,e,l->ssm_alpha,emb,DS4_N_SSM_DT_RANK,p->normed,count) &&
+                qwen35_project_rows(p->beta,e,l->ssm_beta,emb,DS4_N_SSM_DT_RANK,p->normed,count) &&
+                ds4_gpu_qwen35_conv1d_silu_tensor(mm,ms,l->ssm_conv1d->abs_offset,p->qkv,c,p->qkv_silu,conv,DS4_N_SSM_CONV,count,1) &&
+                ds4_gpu_qwen35_gdn_step_tensor(p->qkv_silu,p->z,p->alpha,p->beta,mm,ms,l->ssm_a->abs_offset,l->ssm_dt_bias->abs_offset,
+                    l->ssm_norm->abs_offset,g,p->gdn_out,count,DS4_N_SSM_STATE,DS4_N_SSM_DT_RANK,DS4_N_SSM_GROUP,DS4_RMS_EPS) &&
+                qwen35_project_rows(p->proj,e,l->ssm_out,gd,emb,p->gdn_out,count);
+            ds4_gpu_tensor_free(g); ds4_gpu_tensor_free(c); Q35_CHECK(branch);
+        }
+        Q35_CHECK(ds4_gpu_qwen35_ffn_enter_rows_tensor(p->x,p->proj,p->normed,mm,ms,l->ffn_norm->abs_offset,
+            l->ffn_gate_inp->abs_offset,l->ffn_gate_inp_shexp->abs_offset,p->sel,p->sel_w,p->sgate,p->n_sel,
+            emb,DS4_N_EXPERT,DS4_N_EXPERT_USED,g_q35_expert_min_used ? g_q35_expert_min_used : DS4_N_EXPERT_USED,
+            g_q35_expert_native_used ? g_q35_expert_native_used : DS4_N_EXPERT_USED,DS4_RMS_EPS,g_q35_expert_threshold,
+            il,g_q35_expert_threshold>0,p->acc,count));
+        bool g6=l->ffn_gate_exps->type==DS4_TENSOR_Q6_K, u6=l->ffn_up_exps->type==DS4_TENSOR_Q6_K;
+        bool sg6=l->ffn_gate_shexp->type==DS4_TENSOR_Q6_K, su6=l->ffn_up_shexp->type==DS4_TENSOR_Q6_K;
+        bool d6=l->ffn_down_exps->type==DS4_TENSOR_Q6_K, sd6=l->ffn_down_shexp->type==DS4_TENSOR_Q6_K;
+        uint64_t gbytes=(uint64_t)DS4_N_FF_EXP*(g6 ? emb/256u*210u : emb/32u*34u);
+        uint64_t ubytes=(uint64_t)DS4_N_FF_EXP*(u6 ? emb/256u*210u : emb/32u*34u);
+        uint64_t dbytes=(uint64_t)emb*(d6 ? DS4_N_FF_EXP/256u*210u : DS4_N_FF_EXP/32u*34u);
+        Q35_CHECK(ds4_gpu_qwen35_moe_gate_up_rows_tensor(p->moe_mid,p->normed,mm,ms,l->ffn_gate_exps->abs_offset,
+            l->ffn_up_exps->abs_offset,l->ffn_gate_shexp->abs_offset,l->ffn_up_shexp->abs_offset,gbytes,ubytes,
+            g6,u6,sg6,su6,p->sel,p->n_sel,DS4_N_EXPERT,DS4_N_EXPERT_USED,emb,DS4_N_FF_EXP,count));
+        Q35_CHECK(ds4_gpu_qwen35_moe_down_rows_tensor(p->moe_partial,p->moe_mid,mm,ms,l->ffn_down_exps->abs_offset,
+            l->ffn_down_shexp->abs_offset,dbytes,d6,sd6,p->sel,p->n_sel,DS4_N_EXPERT,DS4_N_EXPERT_USED,DS4_N_FF_EXP,emb,count));
+        Q35_CHECK(ds4_gpu_qwen35_moe_combine_rows_tensor(p->x,p->moe_partial,p->sel_w,p->sgate,p->n_sel,
+            DS4_EXPERT_WEIGHT_SCALE,DS4_N_EXPERT_USED,emb,count));
+        // Bound the driver command to one layer. Cancellation is observed
+        // between layers without dispatching later effects or holding locks.
+        Q35_CHECK(ds4_gpu_end_commands()); Q35_CHECK(ds4_gpu_begin_commands());
+    }
+    if (ds4_session_cancelled(s)) goto done;
+    {
+        ds4_gpu_tensor *last=ds4_gpu_tensor_view(p->x,(uint64_t)(count-1u)*emb*f,emb*f);
+        int projected=last && ds4_gpu_rms_norm_weight_tensor(p->normed,last,mm,ms,e->weights.output_norm->abs_offset,emb,DS4_RMS_EPS) &&
+            qwen35_matmul_weight(p->logits,mm,ms,e->weights.output,emb,DS4_N_VOCAB,p->normed);
+        ds4_gpu_tensor_free(last); Q35_CHECK(projected);
+    }
+    ok=1;
+done:
+    if (!ds4_gpu_end_commands()) ok=0;
+    if (ok) ok=ds4_gpu_tensor_read(p->logits,0,p->host_logits,(uint64_t)DS4_N_VOCAB*f);
+    return ok;
+#undef Q35_CHECK
+}
+
+static int qwen35_prefill_sync(ds4_session *s,const ds4_tokens *prompt,char *err,size_t errlen) {
+    bool extend=s->checkpoint_valid && prompt->len>=s->checkpoint.len && ds4_tokens_starts_with(prompt,&s->checkpoint);
+    int start=extend ? s->checkpoint.len : 0;
+    if (start==prompt->len) return 0;
+    qwen35_prefill p={0}; int result=1;
+    if (!qwen35_prefill_alloc(&p,s,!extend)) { snprintf(err,errlen,"qwen35moe bounded prefill allocation failed"); goto done; }
+    // Reserve checkpoint storage before preparation/publication; no growable
+    // buffer pointers are retained by kernels or callbacks.
+    if (s->checkpoint.cap<prompt->len) {
+        int *reserved=realloc(s->checkpoint.v,(size_t)prompt->len*sizeof(int));
+        if (!reserved) { snprintf(err,errlen,"qwen35moe checkpoint allocation failed"); goto done; }
+        s->checkpoint.v=reserved; s->checkpoint.cap=prompt->len;
+    }
+    for (int first=start;first<prompt->len;) {
+        uint32_t count=(uint32_t)(prompt->len-first); if (count>64u) count=64u;
+        if (s->prefill_cap && count>s->prefill_cap) count=s->prefill_cap;
+        if (ds4_session_cancelled(s)) {result=DS4_SESSION_SYNC_INTERRUPTED;snprintf(err,errlen,"interrupted");goto done;}
+        if (!qwen35_prefill_chunk(s,&p,prompt->v+first,(uint32_t)first,count)) {
+            if (ds4_session_cancelled(s)) {result=DS4_SESSION_SYNC_INTERRUPTED;snprintf(err,errlen,"interrupted");goto done;}
+            goto failed;
+        }
+        if (ds4_session_cancelled(s)) {result=DS4_SESSION_SYNC_INTERRUPTED;snprintf(err,errlen,"interrupted");goto done;}
+        // The synchronous inference owner alone publishes this finished chunk.
+        // Pointer swaps are bounded; old tensors retire after publication.
+#define Q35_SWAP(a,b) do { ds4_gpu_tensor *old=(a); (a)=(b); (b)=old; } while(0)
+        ds4_gpu_tensor *next_k=NULL, *next_v=NULL, *retired_k=NULL, *retired_v=NULL;
+        if (p.fresh) {
+            next_k=ds4_gpu_tensor_view(p.kcache,0,ds4_gpu_tensor_bytes(p.kcache));
+            next_v=ds4_gpu_tensor_view(p.vcache,0,ds4_gpu_tensor_bytes(p.vcache));
+            if (!next_k || !next_v) { ds4_gpu_tensor_free(next_k);ds4_gpu_tensor_free(next_v);goto failed; }
+            if (ds4_session_cancelled(s)) {
+                ds4_gpu_tensor_free(next_k);ds4_gpu_tensor_free(next_v);
+                result=DS4_SESSION_SYNC_INTERRUPTED;snprintf(err,errlen,"interrupted");goto done;
+            }
+            retired_k=s->q35_k_cache;retired_v=s->q35_v_cache;
+            s->q35_k_cache=p.kcache;s->q35_v_cache=p.vcache;
+            p.kcache=next_k;p.vcache=next_v;p.fresh=false;
+        }
+        Q35_SWAP(s->q35_gdn_state,p.gdn_state); Q35_SWAP(s->q35_conv_state,p.conv_state);
+        Q35_SWAP(s->q35_n_sel_acc,p.acc); Q35_SWAP(s->q35_logits,p.logits);
+#undef Q35_SWAP
+        memcpy(s->logits,p.host_logits,(size_t)DS4_N_VOCAB*sizeof(float));
+        memcpy(s->checkpoint.v+first,prompt->v+first,(size_t)count*sizeof(int));
+        first+=(int)count; s->checkpoint.len=first; s->checkpoint_valid=true; s->mtp_draft_valid=false;
+        s->greedy_splitkv_segment.len=0; s->greedy_splitkv_anchor_valid=false;
+        if (s->progress) s->progress(s->progress_ud,"prefill_chunk",first,prompt->len);
+        ds4_gpu_tensor_free(retired_k);ds4_gpu_tensor_free(retired_v);
+    }
+    result=0;goto done;
+failed:
+    snprintf(err,errlen,"qwen35moe bounded prefill failed; committed prefix preserved");
+done:
+    qwen35_prefill_free(&p); return result;
+}
+#endif
