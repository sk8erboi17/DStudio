+/* DStudio candidate preparation: only an empty, unpublished, local Qwen3.8
+ * GPU session is accepted. Kernels, token chunks and context stay unchanged.
+ * Cancellation may stop after a partially evaluated layer and invalidates the
+ * whole candidate, NOT a valid token prefix. The caller owns/discards it and
+ * must revalidate cancellation/ownership before publishing a successful result.
+ * Live sessions must use sync(), whose checkpoint contract is unchanged.
+ * UI-only "prefill_layer" progress counts completed layers, not prompt tokens.
+ * Distributed/tensor-parallel and other model paths are explicitly rejected. */
+int ds4_session_prepare_empty(ds4_session *s, const ds4_tokens *prompt, char *err, size_t errlen);
