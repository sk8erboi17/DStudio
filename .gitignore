linux-smoke.log
*.log.gz
Worker_*_log2timeline-*.log.gz
log2timeline-*.log.gz
core
core.*

# Managed upstream engine checkout. DStudio downloads its pinned antirez/ds4
# runtime here and applies reversible patch sets without vendoring source.
/ds4/
/ds4-glm5.3/
/ds4-glm5.3.zip
/ds4-laguna-s21/

# Runtime diagnostic dump
diagnostics.log

# macOS
.DS_Store

# Generated design-agent workspaces and exported artifacts are local output.
ds4-design/
/design/
/exports/
*.app/
/dist/

